{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@layouts/*": [
        "src/layouts/*"
      ],
      "@shell/*": [
        "src/components/shell/*"
      ],
      "@cards/*": [
        "src/components/cards/*"
      ],
      "@widgets/*": [
        "src/components/widgets/*"
      ],
      "@lms/*": [
        "src/components/lms/*"
      ],
      "@ui/*": [
        "src/components/ui/*"
      ],
      "@ads/*": [
        "src/components/ads/*"
      ],
      "@content/*": [
        "src/content/*"
      ],
      "@styles/*": [
        "src/styles/*"
      ],
      "@demo/*": [
        "src/components/demo/*"
      ]
    }
  }
}