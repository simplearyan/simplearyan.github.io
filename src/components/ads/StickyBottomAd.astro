<div id="sticky-bottom-ad" class="sticky-ad-container expanded">
    <button id="toggle-sticky-ad" class="toggle-btn" aria-label="Toggle Ad">
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="chevron-icon"
        >
            <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
    </button>
    <div class="ad-content">
        <script
            async
            src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7993314093599705"
            crossorigin="anonymous"></script>
        <!-- HORIZONTAL_AD -->
        <ins
            class="adsbygoogle"
            style="display:block"
            data-ad-client="ca-pub-7993314093599705"
            data-ad-slot="6296791861"
            data-ad-format="auto"
            data-full-width-responsive="true"></ins>
        <script is:inline>
            (adsbygoogle = window.adsbygoogle || []).push({});
        </script>
    </div>
</div>

<script>
    const container = document.getElementById("sticky-bottom-ad");
    const toggleBtn = document.getElementById("toggle-sticky-ad");

    if (container && toggleBtn) {
        toggleBtn.addEventListener("click", () => {
            const wasExpanded = container.classList.contains("expanded");

            if (wasExpanded) {
                container.classList.remove("expanded");
                container.classList.add("collapsed");
            } else {
                container.classList.remove("collapsed");
                container.classList.add("expanded");
            }
        });
    }
</script>

<style>
    .sticky-ad-container {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        background: var(--color-bg);
        border-top: 1px solid var(--color-border);
        z-index: 1000;
        box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 0.5rem 0; /* Add some padding back for breathing room */
    }

    .sticky-ad-container.expanded {
        transform: translateY(0);
        background-color: aliceblue;
    }

    .sticky-ad-container.collapsed {
        transform: translateY(100%);
    }

    .toggle-btn {
        position: absolute;
        top: -32px;
        left: 50%;
        transform: translateX(-50%);
        background: var(--color-bg);
        border: 1px solid var(--color-border);
        border-bottom: none;
        border-radius: 8px 8px 0 0;
        width: 48px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: var(--color-text);
        box-shadow: 0 -4px 10px rgba(0, 0, 0, 0.05);
        padding: 0;
    }

    .toggle-btn:hover {
        background: var(--color-surface);
        color: var(--color-primary);
    }

    .chevron-icon {
        transition: transform 0.3s ease;
    }

    /* Flip icon when collapsed (pointing up) */
    .sticky-ad-container.collapsed .chevron-icon {
        transform: rotate(180deg);
    }

    /* Simple container for the ad */
    .ad-content {
        width: 100%;
        max-width: 1000px; /* Limit width on huge screens */
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 90px;
    }
</style>
