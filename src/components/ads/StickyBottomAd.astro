<style>
    .sticky-ad-container {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        background: var(--color-bg);
        border-top: 1px solid var(--color-border);
        z-index: 1000;
        text-align: center; /* Center inline-block content */
        padding: 10px 0;
    }

    .ad-content {
        display: block;
        margin: 0 auto;
        width: 100%;
    }
</style>
