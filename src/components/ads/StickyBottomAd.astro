---
import HorizontalAd from "./HorizontalAd.astro";
---

<div id="sticky-bottom-ad" class="sticky-ad-container expanded">
    <button id="toggle-sticky-ad" class="toggle-btn" aria-label="Toggle Ad">
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="chevron-icon"
        >
            <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
    </button>
    <div class="ad-content">
        <HorizontalAd />
    </div>
</div>

<script>
    const container = document.getElementById("sticky-bottom-ad");
    const toggleBtn = document.getElementById("toggle-sticky-ad");

    if (container && toggleBtn) {
        toggleBtn.addEventListener("click", () => {
            const wasExpanded = container.classList.contains("expanded");

            if (wasExpanded) {
                container.classList.remove("expanded");
                container.classList.add("collapsed");
            } else {
                container.classList.remove("collapsed");
                container.classList.add("expanded");
            }
        });
    }
</script>

<style>
    .sticky-ad-container {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        background: var(--color-bg);
        border-top: 1px solid var(--color-border);
        z-index: 1000;
        box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 0; /* HorizontalAd has its own padding/margin */
    }

    .sticky-ad-container.expanded {
        transform: translateY(0);
        background-color: aliceblue;
    }

    .sticky-ad-container.collapsed {
        transform: translateY(100%);
    }

    .toggle-btn {
        position: absolute;
        top: -32px;
        left: 50%;
        transform: translateX(-50%);
        background: var(--color-bg);
        border: 1px solid var(--color-border);
        border-bottom: none;
        border-radius: 8px 8px 0 0;
        width: 48px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: var(--color-text);
        box-shadow: 0 -4px 10px rgba(0, 0, 0, 0.05);
        padding: 0;
    }

    .toggle-btn:hover {
        background: var(--color-surface);
        color: var(--color-primary);
    }

    .chevron-icon {
        transition: transform 0.3s ease;
    }

    /* Flip icon when collapsed (pointing up) */
    .sticky-ad-container.collapsed .chevron-icon {
        transform: rotate(180deg);
    }

    /* Adjust HorizontalAd styling within this container if needed */
    .ad-content {
        width: 100%;
        max-width: 100%;
        height: 90px; /* Fixed height for leaderboard */
        overflow: hidden;
        /* Ensure ad takes full space but HorizontalAd has margins */
        display: flex;
        justify-content: center;
        align-items: center; /* Center vertically */
    }

    /* Override HorizontalAd margin to fit better */
    :global(.sticky-ad-container .horizontal-ad-container) {
        margin: 0 !important;
        padding: 0 !important;
        background: transparent !important;
        min-height: auto !important;
        height: 100% !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
    }

    /* Force the Google Ads iframe/ins to respect height */
    :global(.sticky-ad-container .adsbygoogle) {
        max-height: 90px !important;
        height: 90px !important;
    }

    /* Hide the text label to save vertical space */
    :global(.sticky-ad-container .ad-label) {
        display: none !important;
    }
</style>
