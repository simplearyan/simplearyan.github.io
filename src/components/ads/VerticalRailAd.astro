---

<div class="vertical-rail-container">
    <!-- Left Rail -->
    <div class="vertical-rail-ad left-rail">
        <div class="ad-label">Advertisement</div>
        <script
            async
            src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7993314093599705"
            crossorigin="anonymous"></script>
        <!-- VERTICAL_AD -->
        <ins
            class="adsbygoogle"
            style="display:block"
            data-ad-client="ca-pub-7993314093599705"
            data-ad-slot="9544937585"
            data-ad-format="auto"
            data-full-width-responsive="true"></ins>
        <script is:inline>
            (adsbygoogle = window.adsbygoogle || []).push({});
        </script>
    </div>

    <!-- Right Rail -->
    <div class="vertical-rail-ad right-rail">
        <div class="ad-label">Advertisement</div>
        <script
            async
            src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7993314093599705"
            crossorigin="anonymous"></script>
        <!-- VERTICAL_AD -->
        <ins
            class="adsbygoogle"
            style="display:block"
            data-ad-client="ca-pub-7993314093599705"
            data-ad-slot="9544937585"
            data-ad-format="auto"
            data-full-width-responsive="true"></ins>
        <script is:inline>
            (adsbygoogle = window.adsbygoogle || []).push({});
        </script>
    </div>
</div>

<style>
    .vertical-rail-ad {
        position: fixed;
        top: 50%;
        transform: translateY(-50%);
        width: 180px;
        min-height: 700px;
        z-index: 1000;
        display: none; /* Hidden by default */
        /* background-color: aliceblue; */
    }

    .left-rail {
        left: 40px;
    }

    .right-rail {
        right: 40px;
    }

    .ad-label {
        font-size: 0.6rem;
        color: var(--color-text-muted);
        text-transform: uppercase;
        margin-bottom: 5px;
        text-align: center;
    }

    /* Show only on large desktop screens */
    @media (min-width: 1300px) {
        .vertical-rail-ad {
            display: block;
        }
    }

    @media (max-width: 1300px) and (min-width: 1000px) {
        .vertical-rail-ad {
            display: block;
            width: 120px;
            min-height: 500px;
            background-color: aliceblue;
        }
        .right-rail {
            right: 10px;
        }
        .left-rail {
            left: 10px;
        }
    }
</style>
