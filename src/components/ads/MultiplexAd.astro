<div class="multiplex-ad-container">
    <div class="ad-label">Sponsored Content</div>
    <script
        async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7993314093599705"
        crossorigin="anonymous"></script>
    <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-format="autorelaxed"
        data-ad-client="ca-pub-7993314093599705"
        data-ad-slot="9378891405"></ins>
    <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
</div>

<style>
    .multiplex-ad-container {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--color-border);
        width: 100%;
        border-bottom: 1px solid var(--color-border);
        background-color: var(--color-bg-offset);
    }

    .ad-label {
        font-family: "Inter", sans-serif;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-text-muted);
        margin-bottom: 1.5rem;
        text-align: center;
    }
</style>
