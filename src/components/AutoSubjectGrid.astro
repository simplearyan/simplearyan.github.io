---
import { getCollection } from "astro:content";
import SubjectCard from "./SubjectCard.astro";
import EnhancedSubjectCard from "./EnhancedSubjectCard.astro";
import ProfessionalSubjectCard from "./ProfessionalSubjectCard.astro";
import HolographicSubjectCard from "./HolographicSubjectCard.astro";
import SwissSubjectCard from "./SwissSubjectCard.astro";
import OrganicSubjectCard from "./OrganicSubjectCard.astro";
import BookCard from "./BookCard.astro";

interface Props {
    courseSlug: string;
    cardStyle?:
        | "original"
        | "enhanced"
        | "professional"
        | "holographic"
        | "swiss"
        | "organic";
    defaultIcon?: string;
}

const {
    courseSlug,
    cardStyle = "professional",
    defaultIcon = "📚",
} = Astro.props;

const allEducation = await getCollection("education");
const allItems = allEducation
    .filter((entry) => entry.data.parent === courseSlug)
    .sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

// Separate Textbooks from regular Subjects/Lessons
const textbooks = allItems.filter((item) =>
    item.data.tags?.includes("Textbook"),
);
const regularItems = allItems.filter(
    (item) => !item.data.tags?.includes("Textbook"),
);

const firstItem = allItems[0];
const isLessonLevel =
    firstItem?.data.type === "unit" || firstItem?.data.type === "lesson";
const gridTitle = isLessonLevel ? "Course Lessons" : "Course Subjects";
---

<div class="grid-wrapper">
    {/* Regular Subjects Section */}
    <div class="grid-container">
        <h2 class="grid-title">{gridTitle}</h2>
        <div class="auto-subject-grid">
            {
                regularItems.map((lesson, index) => {
                    const href = `/education/${lesson.slug}`;
                    const title = lesson.data.title;
                    const subtitle =
                        lesson.data.description || `Module ${index + 1}`;
                    const icon = defaultIcon;

                    // Determine color based on title
                    let cardColor = "var(--color-primary)";
                    if (title.includes("Mathematics")) {
                        cardColor = "#ef4444"; // Red
                    } else if (title.includes("Statistics")) {
                        cardColor = "#f59e0b"; // Amber/Orange
                    } else if (title.includes("English")) {
                        cardColor = "#3b82f6"; // Blue
                    } else if (title.includes("Computational")) {
                        cardColor = "#10b981"; // Emerald
                    }

                    if (cardStyle === "enhanced") {
                        return (
                            <EnhancedSubjectCard
                                title={title}
                                subtitle={subtitle}
                                href={href}
                                index={index}
                                icon={icon}
                                color={cardColor}
                            />
                        );
                    }

                    if (cardStyle === "holographic") {
                        return (
                            <HolographicSubjectCard
                                title={title}
                                subtitle={subtitle}
                                href={href}
                                icon={icon}
                                color={cardColor}
                            />
                        );
                    }

                    if (cardStyle === "swiss") {
                        return (
                            <SwissSubjectCard
                                title={title}
                                subtitle={subtitle}
                                href={href}
                                index={index + 1}
                                icon={icon}
                                color={cardColor}
                            />
                        );
                    }

                    if (cardStyle === "organic") {
                        return (
                            <OrganicSubjectCard
                                title={title}
                                subtitle={subtitle}
                                href={href}
                                icon={icon}
                                color={cardColor}
                            />
                        );
                    }

                    if (cardStyle === "original") {
                        return (
                            <SubjectCard
                                title={title}
                                href={href}
                                icon={icon}
                                color={cardColor}
                            />
                        );
                    }

                    return (
                        <ProfessionalSubjectCard
                            title={title}
                            subtitle={subtitle}
                            href={href}
                            icon={icon}
                            color={cardColor}
                        />
                    );
                })
            }
        </div>
    </div>

    {/* Textbooks Section */}
    {
        textbooks.length > 0 && (
            <div class="grid-container book-section">
                <h2 class="grid-title">Course Books & Resources</h2>
                <div class="book-grid">
                    {textbooks.map((book) => {
                        const isMaths =
                            book.slug.includes("maths-2") ||
                            book.data.title.includes("Linear Algebra");
                        const isStats =
                            book.slug.includes("stats-2") ||
                            book.data.title.includes("Probability");

                        let pattern = "circles";
                        let fontStyle = "serif";
                        let layoutStyle = "classic";
                        let coverColor = book.data.cardColor || "#3b82f6";

                        if (isMaths) {
                            pattern = "grid";
                            fontStyle = "sans";
                            layoutStyle = "modern";
                            coverColor = "#3b82f6"; // Ensure consistent blue
                        } else if (isStats) {
                            pattern = "waves";
                            fontStyle = "serif";
                            layoutStyle = "classic";
                            // coverColor usually handled by book.data.cardColor but fallback:
                            if (!book.data.cardColor) coverColor = "#ec4899";
                        }

                        return (
                            <BookCard
                                title={book.data.title
                                    .replace("Book:", "")
                                    .trim()}
                                subtitle={book.data.description}
                                href={`/education/${book.slug}`}
                                coverColor={coverColor}
                                pattern={pattern as any}
                                fontStyle={fontStyle as any}
                                layoutStyle={layoutStyle as any}
                            />
                        );
                    })}
                </div>
            </div>
        )
    }
</div>

<style>
    .grid-wrapper {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .grid-container {
        margin-bottom: 3rem;
    }

    .grid-title {
        font-family: "Playfair Display", serif;
        font-size: 2rem;
        font-weight: 700;
        color: var(--color-heading);
        margin-bottom: 1.5rem;
        position: relative;
        display: inline-block;
        border-bottom: none !important;
    }

    .grid-title::after {
        content: "";
        position: absolute;
        bottom: -8px;
        left: 0;
        width: 60px;
        height: 3px;
        background: var(--color-primary);
        border-radius: 2px;
    }

    .auto-subject-grid {
        display: grid;
        gap: 1.5rem;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }

    .book-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 3rem;
        padding-top: 1rem;
    }

    @media (max-width: 480px) {
        .book-grid {
            /* On very small screens, maybe just 2 columns with smaller gap or 1 column if needed */
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
        }
    }
</style>
