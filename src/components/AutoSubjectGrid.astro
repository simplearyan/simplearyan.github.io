---
import { getCollection } from "astro:content";
import SubjectCard from "./SubjectCard.astro";
import EnhancedSubjectCard from "./EnhancedSubjectCard.astro";
import ProfessionalSubjectCard from "./ProfessionalSubjectCard.astro";
import BookCard from "./BookCard.astro";

interface Props {
    courseSlug: string;
    cardStyle?: "original" | "enhanced" | "professional";
    defaultIcon?: string;
}

const {
    courseSlug,
    cardStyle = "professional",
    defaultIcon = "📚",
} = Astro.props;

const allEducation = await getCollection("education");
const allItems = allEducation
    .filter((entry) => entry.data.parent === courseSlug)
    .sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

// Separate Textbooks from regular Subjects/Lessons
const textbooks = allItems.filter((item) =>
    item.data.tags?.includes("Textbook"),
);
const regularItems = allItems.filter(
    (item) => !item.data.tags?.includes("Textbook"),
);

const firstItem = allItems[0];
const isLessonLevel =
    firstItem?.data.type === "unit" || firstItem?.data.type === "lesson";
const gridTitle = isLessonLevel ? "Course Lessons" : "Course Subjects";
---

<div class="grid-wrapper">
    {/* Regular Subjects Section */}
    <div class="grid-container">
        <h2 class="grid-title">{gridTitle}</h2>
        <div class="auto-subject-grid">
            {
                regularItems.map((lesson, index) => {
                    const href = `/education/${lesson.slug}`;
                    const title = lesson.data.title;
                    const subtitle =
                        lesson.data.description || `Module ${index + 1}`;
                    const icon = defaultIcon;

                    // Determine color based on title
                    let cardColor = "var(--color-primary)";
                    if (title.includes("Mathematics")) {
                        cardColor = "#ef4444"; // Red
                    } else if (title.includes("Statistics")) {
                        cardColor = "#f59e0b"; // Amber/Orange
                    } else if (title.includes("English")) {
                        cardColor = "#3b82f6"; // Blue
                    } else if (title.includes("Computational")) {
                        cardColor = "#10b981"; // Emerald
                    }

                    if (cardStyle === "enhanced") {
                        return (
                            <EnhancedSubjectCard
                                title={title}
                                subtitle={subtitle}
                                href={href}
                                index={index}
                                icon={icon}
                                color={cardColor}
                            />
                        );
                    }

                    if (cardStyle === "original") {
                        return (
                            <SubjectCard
                                title={title}
                                href={href}
                                icon={icon}
                                color={cardColor}
                            />
                        );
                    }

                    return (
                        <ProfessionalSubjectCard
                            title={title}
                            subtitle={subtitle}
                            href={href}
                            icon={icon}
                            color={cardColor}
                        />
                    );
                })
            }
        </div>
    </div>

    {/* Textbooks Section */}
    {
        textbooks.length > 0 && (
            <div class="grid-container book-section">
                <h2 class="grid-title">Course Books & Resources</h2>
                <div class="book-grid">
                    {textbooks.map((book) => {
                        let coverColor = "#3b82f6"; // Default Blue
                        let pattern = "circles";

                        if (book.data.title.includes("Stats")) {
                            coverColor = "#ec4899"; // Pink/Rose
                            pattern = "grid";
                        } else if (book.data.title.includes("Calculus")) {
                            coverColor = "#8b5cf6"; // Violet
                            pattern = "waves";
                        }

                        return (
                            <BookCard
                                title={book.data.title}
                                subtitle={book.data.description}
                                href={`/education/${book.slug}`}
                                coverColor={coverColor}
                                pattern={pattern as any}
                            />
                        );
                    })}
                </div>
            </div>
        )
    }
</div>

<style>
    .grid-wrapper {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .grid-container {
        margin-bottom: 3rem;
    }

    .grid-title {
        font-family: "Playfair Display", serif;
        font-size: 2rem;
        font-weight: 700;
        color: var(--color-heading);
        margin-bottom: 1.5rem;
        position: relative;
        display: inline-block;
        border-bottom: none !important;
    }

    .grid-title::after {
        content: "";
        position: absolute;
        bottom: -8px;
        left: 0;
        width: 60px;
        height: 3px;
        background: var(--color-primary);
        border-radius: 2px;
    }

    .auto-subject-grid {
        display: grid;
        gap: 1.5rem;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }

    .book-grid {
        display: grid;
        gap: 2rem;
        /* Adjusted for better mobile responsiveness - allows 2 columns on most phones */
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        padding-top: 1rem;
    }
</style>
