---
interface Props {
    src: string;
    alt: string;
    caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="demo-figure">
    <div class="image-wrapper">
        <img src={src} alt={alt} loading="lazy" />
    </div>
    {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
    .demo-figure {
        margin: 2rem 0;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .image-wrapper {
        background: white;
        padding: 0.5rem;
        border: 1px solid var(--color-border, #ddd);
        border-radius: 8px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        max-width: 100%;
        overflow: hidden;
    }

    /* Dark mode support for image wrapper */
    :global(.dark) .image-wrapper {
        background: #222;
        border-color: #444;
    }

    img {
        display: block;
        max-width: 100%;
        height: auto;
        border-radius: 4px;
    }

    figcaption {
        margin-top: 0.75rem;
        font-size: 0.9rem;
        color: var(--color-text-muted, #666);
        font-style: italic;
        text-align: center;
        font-family: var(--font-body, sans-serif);
    }
</style>
