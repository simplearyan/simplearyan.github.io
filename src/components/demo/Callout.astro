---
interface Props {
    type?: "info" | "warning" | "tip" | "note";
    title?: string;
}

const { type = "info", title } = Astro.props;

const icons = {
    info: "ℹ️",
    warning: "⚠️",
    tip: "💡",
    note: "📝",
};

const colors = {
    info: "var(--color-blue-100)",
    warning: "var(--color-yellow-100)",
    tip: "var(--color-green-100)",
    note: "var(--color-gray-100)",
};

const borderColors = {
    info: "var(--color-blue-500)",
    warning: "var(--color-yellow-500)",
    tip: "var(--color-green-500)",
    note: "var(--color-gray-500)",
};
---

<div class={`callout ${type}`}>
    <div class="callout-header">
        <span class="icon">{icons[type]}</span>
        {title && <span class="title">{title}</span>}
    </div>
    <div class="callout-content">
        <slot />
    </div>
</div>

<style>
    .callout {
        padding: 1rem;
        border-radius: 8px;
        margin: 1.5rem 0;
        border-left: 4px solid;
        background-color: var(--bg-color, #f9f9f9); /* Fallback */
        transition: transform 0.2s ease;
    }

    /* Theming based on type */
    .callout.info {
        background-color: color-mix(
            in srgb,
            var(--color-blue-500) 10%,
            transparent
        );
        border-left-color: var(--color-blue-500, #3b82f6);
    }

    .callout.warning {
        background-color: color-mix(
            in srgb,
            var(--color-yellow-500) 10%,
            transparent
        );
        border-left-color: var(--color-yellow-500, #eab308);
    }

    .callout.tip {
        background-color: color-mix(
            in srgb,
            var(--color-green-500) 10%,
            transparent
        );
        border-left-color: var(--color-green-500, #22c55e);
    }

    .callout.note {
        background-color: color-mix(
            in srgb,
            var(--color-text-main) 5%,
            transparent
        );
        border-left-color: var(--color-text-main, #333);
    }

    .callout-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        font-family: var(--font-header, sans-serif);
    }

    .title {
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.05em;
    }

    .callout-content {
        font-size: 0.95rem;
        line-height: 1.6;
    }

    /* Hand-drawn touch for the aesthetic */
    :global(.theme-hand-drawn) .callout {
        border-radius: 2px 255px 3px 25px / 255px 5px 225px 3px;
        box-shadow: 2px 3px 5px rgba(0, 0, 0, 0.05);
    }
</style>
