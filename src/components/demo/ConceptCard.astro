---
interface Props {
    title: string;
    icon?: string;
}

const { title, icon = "🧠" } = Astro.props;
---

<div class="concept-card">
    <div class="card-header">
        <span class="card-icon">{icon}</span>
        <h4 class="card-title">{title}</h4>
    </div>
    <div class="card-body">
        <slot />
    </div>
    <div class="card-footer">
        <span class="read-more">Concept Review</span>
    </div>
</div>

<style>
    .concept-card {
        background: var(--bg-card, #fff);
        border: 1px solid var(--color-border, #e5e7eb);
        border-radius: 12px;
        padding: 1.5rem;
        margin: 1.5rem 0;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        cursor: default;
    }

    /* Dark mode adaptation */
    :global(.dark) .concept-card {
        background: #1a1a1a;
        border-color: #333;
    }

    .concept-card:hover {
        transform: translateY(-4px);
        box-shadow:
            0 10px 15px -3px rgba(0, 0, 0, 0.1),
            0 4px 6px -2px rgba(0, 0, 0, 0.05);
        border-color: var(--color-accent, #3b82f6);
    }

    .card-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px dashed var(--color-border, #e5e7eb);
    }

    .card-icon {
        font-size: 1.5rem;
        background: var(--bg-soft, #f3f4f6);
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }

    :global(.dark) .card-icon {
        background: #333;
    }

    .card-title {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--color-text-main, #111);
    }

    .card-body {
        color: var(--color-text-body, #374151);
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .card-footer {
        margin-top: 1rem;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-accent, #3b82f6);
        font-weight: 600;
        opacity: 0;
        transform: translateY(10px);
        transition: all 0.3s ease;
    }

    .concept-card:hover .card-footer {
        opacity: 1;
        transform: translateY(0);
    }
</style>
