---
interface Props {
    headers: string[];
    rows: string[][];
    style?:
        | "normal"
        | "hand-drawn"
        | "bold"
        | "colorful"
        | "sketchy"
        | "minimal"
        | "sketchy-outline"
        | "sketchy-colorful-outline"
        | "bold-colorful";
    color?:
        | "default"
        | "red"
        | "blue"
        | "green"
        | "yellow"
        | "purple"
        | "orange";
    animation?:
        | "none"
        | "fade"
        | "slide-up"
        | "slide-left"
        | "slide-right"
        | "zoom-in";
    font?: "hand-drawn" | "sans" | "serif" | "mono";
    trigger?: "load" | "visible";
    class?: string;
}

const {
    headers,
    rows,
    style = "normal",
    color = "default",
    animation = "none",
    font = "hand-drawn",
    trigger = "load",
    class: className,
} = Astro.props;
---

<div
    class={`custom-table-container style-${style} font-${font} animate-${animation} ${className || ""}`}
    data-trigger={trigger}
    data-color={color}
>
    {
        rows && rows.length > 0 ? (
            <table>
                <thead>
                    <tr>
                        {headers.map((header) => (
                            <th>{header}</th>
                        ))}
                    </tr>
                </thead>
                <tbody>
                    {rows.map((row) => (
                        <tr>
                            {row.map((cell) => (
                                <td>{cell}</td>
                            ))}
                        </tr>
                    ))}
                </tbody>
            </table>
        ) : (
            <slot />
        )
    }
</div>

<script>
    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("in-view");
                    observer.unobserve(entry.target);
                }
            });
        },
        { threshold: 0.1 },
    );

    const initAnimations = () => {
        const visibleTables = document.querySelectorAll(
            '.custom-table-container[data-trigger="visible"]',
        );
        visibleTables.forEach((el) => {
            observer.observe(el);
        });

        // Trigger load animations immediately
        const loadTables = document.querySelectorAll(
            '.custom-table-container[data-trigger="load"]',
        );
        loadTables.forEach((el) => {
            requestAnimationFrame(() => {
                el.classList.add("in-view");
            });
        });
    };

    // Run on load
    initAnimations();

    // Run on Astro page navigation
    document.addEventListener("astro:page-load", () => {
        initAnimations();
    });
</script>

<style>
    .custom-table-container {
        display: block; /* Ensure block context for overflow */
        width: 100%;
        overflow-x: auto;
        margin: 2rem 0;
        --table-border-color: var(--theme-border);
        --table-bg: var(--color-code-bg);
        --table-text: var(--color-text);
        --header-bg: var(--theme-bg);
        --header-text: var(--theme-text);
    }

    /* Color Themes */
    .custom-table-container[data-color="default"] {
        --theme-border: var(--color-border);
        --theme-bg: var(--color-surface);
        --theme-text: var(--color-heading);
    }

    .custom-table-container[data-color="red"] {
        --theme-border: #ef4444;
        --theme-bg: rgba(239, 68, 68, 0.1);
        --theme-text: #991b1b;
    }
    :global(.dark) .custom-table-container[data-color="red"] {
        --theme-border: #f87171;
        --theme-bg: rgba(239, 68, 68, 0.2);
        --theme-text: #fecaca;
    }

    .custom-table-container[data-color="blue"] {
        --theme-border: #3b82f6;
        --theme-bg: rgba(59, 130, 246, 0.1);
        --theme-text: #1e40af;
    }
    :global(.dark) .custom-table-container[data-color="blue"] {
        --theme-border: #60a5fa;
        --theme-bg: rgba(59, 130, 246, 0.2);
        --theme-text: #bfdbfe;
    }

    .custom-table-container[data-color="green"] {
        --theme-border: #22c55e;
        --theme-bg: rgba(34, 197, 94, 0.1);
        --theme-text: #166534;
    }
    :global(.dark) .custom-table-container[data-color="green"] {
        --theme-border: #4ade80;
        --theme-bg: rgba(34, 197, 94, 0.2);
        --theme-text: #bbf7d0;
    }

    .custom-table-container[data-color="yellow"] {
        --theme-border: #eab308;
        --theme-bg: rgba(234, 179, 8, 0.15);
        --theme-text: #854d0e;
    }
    :global(.dark) .custom-table-container[data-color="yellow"] {
        --theme-border: #facc15;
        --theme-bg: rgba(234, 179, 8, 0.2);
        --theme-text: #fef08a;
    }

    .custom-table-container[data-color="purple"] {
        --theme-border: #a855f7;
        --theme-bg: rgba(168, 85, 247, 0.1);
        --theme-text: #6b21a8;
    }
    :global(.dark) .custom-table-container[data-color="purple"] {
        --theme-border: #c084fc;
        --theme-bg: rgba(168, 85, 247, 0.2);
        --theme-text: #e9d5ff;
    }

    .custom-table-container[data-color="orange"] {
        --theme-border: #f97316;
        --theme-bg: rgba(249, 115, 22, 0.1);
        --theme-text: #9a3412;
    }
    :global(.dark) .custom-table-container[data-color="orange"] {
        --theme-border: #fb923c;
        --theme-bg: rgba(249, 115, 22, 0.2);
        --theme-text: #fed7aa;
    }

    /* Default overrides if color is default */
    .custom-table-container[data-color="default"] {
        --header-bg: var(--color-surface);
        --header-text: var(--color-heading);
    }

    /* Fonts */
    .font-hand-drawn {
        font-family: "Kalam", cursive, sans-serif;
    }
    .font-sans {
        font-family: var(--font-sans, system-ui, sans-serif);
    }
    .font-serif {
        font-family: var(--font-serif, Georgia, serif);
    }
    .font-mono {
        font-family: var(--font-mono, monospace);
    }

    .custom-table-container :global(table) {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.95rem;
        color: var(--table-text);
    }

    .custom-table-container :global(th),
    .custom-table-container :global(td) {
        padding: 0.75rem 1rem;
        text-align: left;
        border-bottom: 1px solid var(--table-border-color);
    }

    .custom-table-container :global(th) {
        font-weight: 600;
        background-color: var(--header-bg);
        color: var(--header-text);
    }

    /* Style: Normal */
    .style-normal :global(table) {
        border: 1px solid var(--table-border-color);
        border-radius: 8px;
        overflow: hidden;
    }

    /* Style: Hand-Drawn */
    .style-hand-drawn :global(table) {
        border-collapse: separate;
        border-spacing: 0;
        border: 2px solid var(--table-text);
        border-radius: 2px 255px 3px 25px / 255px 5px 225px 3px;
        box-shadow: 2px 3px 5px rgba(0, 0, 0, 0.1);
    }

    .style-hand-drawn :global(th),
    .style-hand-drawn :global(td) {
        border-bottom: 2px solid var(--table-text);
        border-right: 2px solid var(--table-text);
    }

    .style-hand-drawn :global(th:last-child),
    .style-hand-drawn :global(td:last-child) {
        border-right: none;
    }

    .style-hand-drawn :global(tr:last-child td) {
        border-bottom: none;
    }

    /* Style: Bold */
    .style-bold :global(th) {
        background-color: var(--theme-text);
        color: var(--color-bg);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 3px solid var(--theme-border);
    }

    .style-bold :global(table) {
        border: 3px solid var(--theme-text);
    }

    .style-bold :global(td) {
        border-bottom: 1px solid var(--theme-text);
        font-weight: 500;
    }

    /* Style: Colorful */
    .style-colorful :global(th) {
        background-color: var(--theme-border);
        color: white;
    }

    .style-colorful :global(tr:nth-child(even)) {
        background-color: var(--theme-bg);
    }

    .style-colorful :global(table) {
        border: 2px solid var(--theme-border);
        border-radius: 8px;
        overflow: hidden;
    }

    /* Style: Sketchy */
    .style-sketchy :global(table) {
        border: 3px solid var(--theme-border);
        border-radius: 4px;
        background: var(--color-code-bg);
        box-shadow: 4px 4px 0 var(--theme-border);
    }

    .style-sketchy :global(th) {
        background: transparent;
        border-bottom: 2px dashed var(--theme-border);
        color: var(--theme-text);
    }

    .style-sketchy :global(td) {
        border-bottom: 1px dashed var(--theme-border);
    }

    /* Style: Sketchy Outline */
    .style-sketchy-outline :global(table) {
        border: 3px solid var(--table-text);
        border-radius: 2px 255px 3px 25px / 255px 5px 225px 3px;
        background: transparent;
    }

    .style-sketchy-outline :global(th) {
        background: transparent;
        border-bottom: 3px solid var(--table-text);
        color: var(--table-text);
    }

    .style-sketchy-outline :global(td) {
        border-bottom: 1px solid var(--table-text);
    }

    /* Style: Sketchy Colorful Outline */
    .style-sketchy-colorful-outline :global(table) {
        border: 3px solid var(--theme-border);
        border-radius: 2px 255px 3px 25px / 255px 5px 225px 3px;
        background: var(--theme-bg);
    }

    .style-sketchy-colorful-outline :global(th) {
        background: var(--theme-border);
        color: white;
        border-bottom: 3px solid var(--theme-border);
    }

    .style-sketchy-colorful-outline :global(td) {
        border-bottom: 1px solid var(--theme-border);
        background: var(--color-code-bg);
    }

    /* Style: Minimal */
    .style-minimal :global(table) {
        border: none;
    }

    .style-minimal :global(th) {
        background: transparent;
        border-bottom: 2px solid var(--theme-border);
        color: var(--theme-text);
        padding-left: 0;
    }

    .style-minimal :global(td) {
        border-bottom: 1px solid var(--color-border);
        padding-left: 0;
    }

    /* Style: Bold Colorful */
    .style-bold-colorful :global(table) {
        border: 3px solid var(--theme-border);
        border-radius: 8px;
        overflow: hidden;
    }

    .style-bold-colorful :global(th) {
        background-color: var(--theme-border);
        color: white;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 3px solid var(--theme-border);
    }

    .style-bold-colorful :global(tr:nth-child(even)) {
        background-color: var(--theme-bg);
    }

    .style-bold-colorful :global(td) {
        border-bottom: 1px solid var(--theme-border);
        font-weight: 500;
    }

    /* Animations */
    /* Only animate when .in-view is present */
    .custom-table-container.in-view.animate-fade {
        animation: fadeIn 0.8s ease-out forwards;
    }

    .custom-table-container.in-view.animate-slide-up {
        animation: slideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .custom-table-container.in-view.animate-slide-left {
        animation: slideLeft 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .custom-table-container.in-view.animate-slide-right {
        animation: slideRight 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .custom-table-container.in-view.animate-zoom-in {
        animation: zoomIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Initial states for animations - EXCLUDE animate-none */
    .custom-table-container:not(.in-view):not(
            .animate-none
        )[class*="animate-"] {
        opacity: 0;
    }

    .custom-table-container:not(.in-view).animate-slide-up {
        transform: translateY(20px);
    }
    .custom-table-container:not(.in-view).animate-slide-left {
        transform: translateX(20px);
    }
    .custom-table-container:not(.in-view).animate-slide-right {
        transform: translateX(-20px);
    }
    .custom-table-container:not(.in-view).animate-zoom-in {
        transform: scale(0.9);
    }

    @keyframes fadeIn {
        to {
            opacity: 1;
        }
    }

    @keyframes slideUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes slideLeft {
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @keyframes slideRight {
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @keyframes zoomIn {
        to {
            opacity: 1;
            transform: scale(1);
        }
    }
</style>
