---
const today = new Date();
---

<footer>
  <div class="container">
    <p>
      &copy; {today.getFullYear()}
      <a href="/" class="logo">
        <span class="logo-a">aryan</span>
        <span class="logo-x">x</span>
      </a>
      All rights reserved.
      <!-- <span class="footer-separator">•</span>
      <span id="footer-date"></span>
    </p>
    <script>
      const footerDate = document.getElementById("footer-date");
      if (footerDate) {
        footerDate.textContent = new Date().toLocaleDateString("en-US", {
          weekday: "long",
          year: "numeric",
          month: "long",
          day: "numeric",
        });
      }
    </script> -->
    <div class="social-links">
      <a href="/about">About</a>
      <a href="#" target="_blank" rel="noopener noreferrer">Twitter</a>
      <a
        href="https://github.com/simplearyan?tab=repositories"
        target="_blank"
        rel="noopener noreferrer">GitHub</a
      >
      <a
        href="https://simplearyan.github.io/aryan-blog/"
        target="_blank"
        rel="noopener noreferrer">OldSite</a
      >
      <a href="/kinetix" target="_blank" rel="noopener noreferrer">Kinetix</a>
    </div>
  </div>
</footer>

<style>
  footer {
    margin-top: 2rem;
    padding: var(--spacing-xl) 0;
    border-top: 1px solid var(--color-border);
    color: #666;
  }

  .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .social-links {
    display: flex;
    gap: var(--spacing-md);
  }

  a:hover {
    color: var(--color-primary);
  }

  .logo {
    display: inline-flex;
    align-items: baseline;
    text-decoration: none;
    line-height: 1;
    color: #666;
    margin: 0 0.25rem;
  }

  .logo-a {
    font-family: "Playfair Display", serif;
    font-size: 1.5rem;
    font-weight: 700;
    font-style: italic;
    letter-spacing: -0.05em;
  }

  .logo-x {
    font-family: "Kalam", cursive;
    font-size: 1rem;
    font-weight: 700;
    margin-left: 1.5px;
    transform: translateY(-7px);
  }

  @media (max-width: 768px) {
    .container {
      flex-direction: column;
      gap: var(--spacing-md);
      text-align: center;
    }

    .social-links {
      justify-content: center;
    }

    .footer-separator {
      display: none;
    }

    #footer-date {
      display: block;
      margin-top: 0.5rem;
    }
  }
</style>
