---
interface Props {
    ballCounts?: Record<string, number>; // e.g. { red: 5, blue: 3 }
    size?: number;
    containerColor?: string;
    animateExtraction?: boolean;
}

const {
    ballCounts = { red: 5, blue: 3 },
    size = 200,
    containerColor = "rgba(200, 200, 255, 0.2)",
    animateExtraction = false,
} = Astro.props;

// Flatten balls into an array for rendering
const balls = Object.entries(ballCounts).flatMap(([color, count]) =>
    Array(count).fill(color),
);

// Simple physics-ish placement (randomized but bounded)
// Container is roughly 100x120 in SVG units
const generatePositions = (count: number) => {
    const pos = [];
    for (let i = 0; i < count; i++) {
        // Randomize within the "belly" of the urn
        // x: 20-80, y: 40-100
        pos.push({
            cx: 25 + Math.random() * 50,
            cy: 50 + Math.random() * 50,
            r: 6,
        });
    }
    return pos;
};

// We rely on stable seed or client hydration for consistency?
// For SSG, Math.random() is fine as it runs at build time.
const positions = generatePositions(balls.length);
---

<div class="urn-container" style={`width: ${size}px; height: ${size * 1.2}px;`}>
    <svg viewBox="0 0 100 120" class="urn-svg">
        <defs>
            <filter id="glass" x="0" y="0" width="200%" height="200%">
                <feGaussianBlur
                    in="SourceGraphic"
                    stdDeviation="1"
                    result="blur"></feGaussianBlur>
                <feSpecularLighting
                    in="blur"
                    surfaceScale="5"
                    specularConstant="1"
                    specularExponent="20"
                    lighting-color="#white"
                    result="specOut"
                >
                    <fePointLight x="-5000" y="-10000" z="20000"></fePointLight>
                </feSpecularLighting>
                <feComposite
                    in="specOut"
                    in2="SourceAlpha"
                    operator="in"
                    result="specOut"></feComposite>
                <feComposite
                    in="SourceGraphic"
                    in2="specOut"
                    operator="arithmetic"
                    k1="0"
                    k2="1"
                    k3="1"
                    k4="0"
                    result="litPaint"></feComposite>
            </filter>
        </defs>

        <!-- Back of Jar -->
        <path
            d="M 20 20 Q 10 20 10 40 L 10 100 Q 10 115 50 115 Q 90 115 90 100 L 90 40 Q 90 20 80 20 Z"
            fill={containerColor}
            stroke="none"></path>

        <!-- Balls -->
        {
            balls.map((color, i) => (
                <circle
                    cx={positions[i].cx}
                    cy={positions[i].cy}
                    r={positions[i].r}
                    fill={color}
                    stroke="rgba(0,0,0,0.2)"
                    stroke-width="0.5"
                    class={
                        animateExtraction && i === balls.length - 1
                            ? "extracting"
                            : ""
                    }
                />
            ))
        }

        <!-- Front Reflection / Shine -->
        <path
            d="M 20 20 Q 10 20 10 40 L 10 100 Q 10 115 50 115 Q 90 115 90 100 L 90 40 Q 90 20 80 20"
            fill="rgba(255,255,255,0.1)"
            stroke="#889"
            stroke-width="2"
            stroke-linejoin="round"></path>

        <path
            d="M 25 30 Q 20 50 20 90"
            stroke="rgba(255,255,255,0.4)"
            stroke-width="2"
            fill="none"></path>
    </svg>
</div>

<style>
    .urn-container {
        display: inline-block;
        margin: 10px;
    }

    .urn-svg {
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .extracting {
        animation: extract 2s ease-in-out infinite;
    }

    @keyframes extract {
        0% {
            transform: translateY(0);
            opacity: 1;
        }
        50% {
            transform: translateY(-60px);
            opacity: 1;
        }
        100% {
            transform: translateY(-80px);
            opacity: 0;
        }
    }
</style>
