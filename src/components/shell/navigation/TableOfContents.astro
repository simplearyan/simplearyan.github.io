---
import katex from "katex";
import type { MarkdownHeading } from "astro";

interface Props {
    headings: MarkdownHeading[];
}

const { headings } = Astro.props;

// Filter out h1 (title) and keep only h2 and h3
const toc = headings.filter((h) => h.depth > 1 && h.depth <= 3);

const renderHeading = (text: string) => {
    // 1. Handle explicit $...$ delimiters
    if (text.includes("$")) {
        return text.replace(/\$([^$]+)\$/g, (m, math) => {
            try {
                return katex.renderToString(math, {
                    throwOnError: false,
                    displayMode: false,
                });
            } catch {
                return m;
            }
        });
    }

    // 2. Heuristic: Handle math-like content (containing backslashes) inside parentheses
    // e.g. "Correlation (\rho)"
    return text.replace(
        /(\(|^)([^()]*\\[^()]*?)(\)|$)/g,
        (match, prefix, inner, suffix) => {
            try {
                const html = katex.renderToString(inner, {
                    throwOnError: false,
                    displayMode: false,
                });
                return prefix + html + suffix;
            } catch {
                return match;
            }
        },
    );
};
---

<nav class="toc">
    <h3 class="toc-title">On This Page</h3>
    <ul class="toc-list">
        {
            toc.map((heading) => (
                <li class={`toc-item depth-${heading.depth}`}>
                    <a
                        href={`#${heading.slug}`}
                        set:html={renderHeading(heading.text)}
                    />
                </li>
            ))
        }
    </ul>
</nav>

<style>
    .toc {
        position: sticky;
        top: 6rem; /* Adjust based on header height + padding */
        max-height: calc(100vh - 8rem);
        overflow-y: auto;
        padding-left: 1.5rem;
        border-left: 1px solid var(--color-border);
    }

    @media (max-width: 1024px) {
        .toc {
            position: static;
            height: 100%;
            max-height: none;
            padding-left: 0;
            border-left: none;
        }
    }

    .toc-title {
        font-family: var(--font-serif);
        font-size: 1.1rem;
        font-weight: 600;
        text-transform: none; /* Remove uppercase for a more elegant look */
        letter-spacing: 0.02em;
        margin-bottom: 1.5rem;
        color: var(--color-heading);
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--color-border);
    }

    .toc-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 1rem; /* Increased gap */
    }

    .toc-item a {
        color: var(--color-text); /* Darker text for better contrast */
        text-decoration: none;
        font-size: 0.95rem;
        transition: all 0.2s ease;
        display: block;
        line-height: 1.5;
        opacity: 0.8;
    }

    .toc-item a:hover {
        color: var(--color-primary);
        opacity: 1;
        transform: translateX(4px); /* Subtle movement */
    }

    .toc-item.depth-3 {
        padding-left: 1.25rem;
        font-size: 0.9rem;
        border-left: 1px solid var(--color-border); /* Visual guide for depth */
    }

    /* Scrollbar styling */
    .toc::-webkit-scrollbar {
        width: 4px;
    }

    .toc::-webkit-scrollbar-track {
        background: transparent;
    }

    .toc::-webkit-scrollbar-thumb {
        background: var(--color-border);
        border-radius: 4px;
    }

    .toc::-webkit-scrollbar-thumb:hover {
        background: var(--color-text-muted);
    }
</style>
