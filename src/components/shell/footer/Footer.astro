---
const today = new Date();
---

<footer>
  <div class="container">
    <p>
      &copy; {today.getFullYear()}
      <a href="/" class="logo">
        <span class="logo-a">aryan</span>
        <span class="logo-x">x</span>
      </a>
      All rights reserved.
      <!-- <span class="footer-separator">•</span>
      <span id="footer-date"></span>
    </p>
    <script>
      const footerDate = document.getElementById("footer-date");
      if (footerDate) {
        footerDate.textContent = new Date().toLocaleDateString("en-US", {
          weekday: "long",
          year: "numeric",
          month: "long",
          day: "numeric",
        });
      }
    </script> -->
      <div class="social-links">
        <a href="/about">About</a>
        <a href="#" target="_blank" rel="noopener noreferrer">Twitter</a>
        <a
          href="https://github.com/simplearyan?tab=repositories"
          target="_blank"
          rel="noopener noreferrer">GitHub</a
        >
        <a
          href="https://simplearyan.github.io/aryan-blog/"
          target="_blank"
          rel="noopener noreferrer">OldSite</a
        >
        <a href="/kinetix" target="_blank" rel="noopener noreferrer">Kinetix</a>
        <button
          id="bg-grain-toggle"
          class="texture-btn"
          aria-label="Toggle Paper Grain"
        >
          Grain: ON
        </button>
        <button
          id="texture-toggle"
          class="texture-btn"
          aria-label="Toggle All Texture"
        >
          Ink: ON
        </button>
      </div>
    </p>
  </div>

  <style>
    footer {
      margin-top: 2rem;
      padding: var(--spacing-xl) 0;
      border-top: 1px solid var(--color-border);
      color: #666;
    }

    .container {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .social-links {
      display: flex;
      gap: var(--spacing-md);
      align-items: center; /* Ensure alignment with button */
    }

    /* ... existing styles ... */
    a:hover {
      color: var(--color-primary);
    }

    .texture-btn {
      background: none;
      border: 1px solid var(--color-border);
      border-radius: 4px;
      padding: 0.25rem 0.75rem;
      font-family: var(--font-mono);
      font-size: 0.85rem;
      color: var(--color-text-muted);
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .texture-btn:hover {
      border-color: var(--color-primary);
      color: var(--color-primary);
    }

    .logo {
      display: inline-flex;
      align-items: baseline;
      text-decoration: none;
      line-height: 1;
      color: #666;
      margin: 0 0.25rem;
    }

    .logo-a {
      font-family: "Playfair Display", serif;
      font-size: 1.5rem;
      font-weight: 700;
      font-style: italic;
      letter-spacing: -0.05em;
    }

    .logo-x {
      font-family: "Kalam", cursive;
      font-size: 1rem;
      font-weight: 700;
      margin-left: 1.5px;
      transform: translateY(-7px);
    }

    @media (max-width: 768px) {
      .container {
        flex-direction: column;
        gap: var(--spacing-md);
        text-align: center;
      }

      .social-links {
        justify-content: center;
        flex-wrap: wrap; /* Handle overflow */
      }

      .footer-separator {
        display: none;
      }

      #footer-date {
        display: block;
        margin-top: 0.5rem;
      }
    }
  </style>

  <script>
    const textureBtn = document.getElementById("texture-toggle");
    const grainBtn = document.getElementById("bg-grain-toggle");
    const body = document.body;

    // Load initial preference
    const texturePref = localStorage.getItem("texture") || "enabled";
    const grainPref = localStorage.getItem("bg-grain") || "enabled";

    function updateTexture(isEnabled: boolean) {
      if (isEnabled) {
        body.classList.remove("no-texture");
        if (textureBtn) textureBtn.textContent = "Ink: ON";
        localStorage.setItem("texture", "enabled");
      } else {
        body.classList.add("no-texture");
        if (textureBtn) textureBtn.textContent = "Ink: OFF";
        localStorage.setItem("texture", "disabled");
      }
    }

    function updateGrain(isEnabled: boolean) {
      if (isEnabled) {
        body.classList.remove("no-bg-grain");
        if (grainBtn) grainBtn.textContent = "Grain: ON";
        localStorage.setItem("bg-grain", "enabled");
      } else {
        body.classList.add("no-bg-grain");
        if (grainBtn) grainBtn.textContent = "Grain: OFF";
        localStorage.setItem("bg-grain", "disabled");
      }
    }

    // Init
    updateTexture(texturePref === "enabled");
    updateGrain(grainPref === "enabled");

    textureBtn?.addEventListener("click", () => {
      const isCurrentlyOn = !body.classList.contains("no-texture");
      updateTexture(!isCurrentlyOn);
    });

    grainBtn?.addEventListener("click", () => {
      const isCurrentlyOn = !body.classList.contains("no-bg-grain");
      updateGrain(!isCurrentlyOn);
    });
  </script>
</footer>
