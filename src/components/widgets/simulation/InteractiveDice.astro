---
interface Props {
    size?: number;
    color?: string; // Main dice color
    dotColor?: string;
}

const {
    size = 100,
    color = "#f5f5f5", // Default off-white for better realism
    dotColor = "#333",
} = Astro.props;
---

<div class="interactive-dice-container">
    <button class="roll-btn" aria-label="Roll Dice">
        <div class="scene">
            <div class="cube is-isometric">
                <!-- 1 -->
                <div class="face front">
                    <span class="dot center"></span>
                </div>
                <!-- 2 -->
                <div class="face back">
                    <span class="dot top-left"></span><span
                        class="dot bottom-right"></span>
                </div>
                <!-- 3 -->
                <div class="face right">
                    <span class="dot top-left"></span><span class="dot center"
                    ></span><span class="dot bottom-right"></span>
                </div>
                <!-- 4 -->
                <div class="face left">
                    <span class="dot top-left"></span><span
                        class="dot top-right"></span>
                    <span class="dot bottom-left"></span><span
                        class="dot bottom-right"></span>
                </div>
                <!-- 5 -->
                <div class="face top">
                    <span class="dot top-left"></span><span
                        class="dot top-right"></span>
                    <span class="dot center"></span>
                    <span class="dot bottom-left"></span><span
                        class="dot bottom-right"></span>
                </div>
                <!-- 6 -->
                <div class="face bottom">
                    <span class="dot top-left"></span><span
                        class="dot top-right"></span>
                    <span class="dot center-left"></span><span
                        class="dot center-right"></span>
                    <span class="dot bottom-left"></span><span
                        class="dot bottom-right"></span>
                </div>
            </div>
        </div>
        <span class="hint">Click to Roll</span>
    </button>
</div>

<!-- Define vars for CSS -->
<style
    define:vars={{
        diceSize: size + "px",
        halfSize: size / 2 + "px",
        diceColor: color,
        dotColor: dotColor,
    }}
>
    .interactive-dice-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
        margin: 2rem 0;
    }

    .roll-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 1rem;
        perspective: 1000px; /* Scene perspective */
        /* Ensure no overflow clipping */
        overflow: visible;
    }

    .scene {
        width: var(--diceSize);
        height: var(--diceSize);
        position: relative;
        transform-style: preserve-3d;
    }

    .cube {
        width: 100%;
        height: 100%;
        position: relative;
        transform-style: preserve-3d;
        /* Slower, smoother landing transition */
        transition: transform 2.5s cubic-bezier(0.19, 1, 0.22, 1);
    }

    /* Initial Isometric Angle */
    .cube.is-isometric {
        transform: rotateX(-25deg) rotateY(-35deg);
    }

    .face {
        position: absolute;
        width: 100%;
        height: 100%;
        background-color: var(--diceColor);
        /* 20% radius with 10% overlap usually seals it well */
        border-radius: 20%;
        box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.15);
        display: grid;
        grid-template: repeat(3, 1fr) / repeat(3, 1fr);
        padding: 14%;
        box-sizing: border-box;
        backface-visibility: hidden;
    }

    /* Gradients for lighting simulation */
    /* Scaled to 1.1 to close gaps with minimal overlap artifacts */
    .front {
        transform: rotateY(0deg) translateZ(var(--halfSize)) scale(1.1);
        background: linear-gradient(135deg, var(--diceColor), #ddd);
    }
    .right {
        transform: rotateY(90deg) translateZ(var(--halfSize)) scale(1.1);
        background: linear-gradient(135deg, #eee, #ccc);
    }
    .back {
        transform: rotateY(180deg) translateZ(var(--halfSize)) scale(1.1);
        background: linear-gradient(135deg, #ddd, #bbb);
    }
    .left {
        transform: rotateY(-90deg) translateZ(var(--halfSize)) scale(1.1);
        background: linear-gradient(135deg, #eee, #ccc);
    }
    .top {
        transform: rotateX(90deg) translateZ(var(--halfSize)) scale(1.1);
        background: linear-gradient(135deg, #fff, #f0f0f0);
    }
    .bottom {
        transform: rotateX(-90deg) translateZ(var(--halfSize)) scale(1.1);
        background: linear-gradient(135deg, #ccc, #999);
    }

    /* Dots */
    .dot {
        background-color: var(--dotColor);
        border-radius: 50%;
        width: 100%;
        height: 100%;
        align-self: center;
        justify-self: center;
        box-shadow: inset 1px 1px 3px rgba(0, 0, 0, 0.6);
        transform: scale(0.5); /* Scale down dot to compensate for face scale */
    }

    /* Dot Positioning Grid Areas */
    .center {
        grid-area: 2 / 2;
    }
    .top-left {
        grid-area: 1 / 1;
    }
    .top-right {
        grid-area: 1 / 3;
    }
    .bottom-left {
        grid-area: 3 / 1;
    }
    .bottom-right {
        grid-area: 3 / 3;
    }
    .center-left {
        grid-area: 2 / 1;
    } /* For 6 */
    .center-right {
        grid-area: 2 / 3;
    } /* For 6 */

    /* 6-face specific for Dice layout (standard Western) */
    /* 
      1: center
      2: top-left, bottom-right
      3: top-left, center, bottom-right
      4: top-left, top-right, bottom-left, bottom-right
      5: top-left, top-right, center, bottom-left, bottom-right
      6: top-left, top-right, center-left, center-right, bottom-left, bottom-right
      Wait, my HTML structure above uses named spans. Let's make sure they map correctly.
      Face 1: front -> center. OK.
      Face 2: back -> top-left, bottom-right. OK. (Opposite 5 usually, but 1 opp 6).
      Let's stick to standard Opposites: 1-6, 2-5, 3-4.
      face front (1). face back (6). NO.
      Standard: Front=1, Back=6. Right=2, Left=5. Top=3, Bottom=4.
      My CSS classes:
      Front (0,0) -> 1
      Back (180,0) -> 6? Only if I put 6 dots there.
      Right (0, 90) -> ?
      
      Let's align HTML to Standard Dice.
      Front: 1
      Back: 6 (HTML needs 6 dots)
      Right: 3
      Left: 4
      Top: 2
      Bottom: 5
    */

    .hint {
        font-family: var(--font-sans);
        color: var(--color-text);
        opacity: 0.7;
        font-size: 0.9rem;
    }

    @keyframes tumble {
        0% {
            transform: rotateX(-25deg) rotateY(-35deg);
        }
        25% {
            transform: rotateX(130deg) rotateY(200deg);
        }
        50% {
            transform: rotateX(-100deg) rotateY(40deg);
        }
        75% {
            transform: rotateX(20deg) rotateY(-130deg);
        }
        100% {
            transform: rotateX(720deg) rotateY(1080deg);
        }
    }

    .tumbling {
        animation: tumble 1.2s linear infinite; /* Slower tumble */
    }
</style>

<script>
    // Standard Dice Orientation Map
    // We need to Rotate the CUBE so the target face is front-and-center (or isometric).
    // If we want isometric landing:
    // We find the rotations to bring Face X to Front (0,0,0).
    // Then we add the Isometric offset (-25, -35).

    // Rotations to bring face to FRONT:
    // 1 (Front): 0, 0
    // 6 (Back): 180, 0 (or 0, 180)
    // 2 (Top - in my new map): -90, 0
    // 5 (Bottom): 90, 0
    // 3 (Right): 0, -90
    // 4 (Left): 0, 90

    // BUT we need to check my HTML mapping.
    // HTML:
    // Front: 1
    // Back: 2 (Need to fix HTML to be 6)
    // Right: 3
    // Left: 4
    // Top: 5
    // Bottom: 6

    // Let's do a quick fix map in JS based on the HTML structure I wrote.
    const faceRotations = {
        1: { x: 0, y: 0 }, // Front
        2: { x: 0, y: 180 }, // Back (Mapped as 2 in HTML currently... wait, I should fix HTML)
        3: { x: 0, y: -90 }, // Right
        4: { x: 0, y: 90 }, // Left
        5: { x: -90, y: 0 }, // Top
        6: { x: 90, y: 0 }, // Bottom
    };

    // Wait, let's fix the HTML to be standard 1-6 opposites.
    // Front: 1
    // Back: 6
    // Top: 2
    // Bottom: 5
    // Right: 3
    // Left: 4

    // I will write the JS to match the HTML I *will* output.
</script>

<!-- RE-WRITING HTML block with correct standard faces -->
<div class="interactive-dice-container">
    <button class="roll-btn" aria-label="Roll Dice">
        <div class="scene">
            <div class="cube is-isometric">
                <!-- FRONT: 1 -->
                <div class="face front">
                    <span class="dot center"></span>
                </div>
                <!-- BACK: 6 -->
                <div class="face back">
                    <span class="dot top-left"></span><span
                        class="dot top-right"></span>
                    <span class="dot center-left"></span><span
                        class="dot center-right"></span>
                    <span class="dot bottom-left"></span><span
                        class="dot bottom-right"></span>
                </div>
                <!-- TOP: 2 -->
                <div class="face top">
                    <span class="dot top-left"></span><span
                        class="dot bottom-right"></span>
                </div>
                <!-- BOTTOM: 5 -->
                <div class="face bottom">
                    <span class="dot top-left"></span><span
                        class="dot top-right"></span>
                    <span class="dot center"></span>
                    <span class="dot bottom-left"></span><span
                        class="dot bottom-right"></span>
                </div>
                <!-- RIGHT: 3 -->
                <div class="face right">
                    <span class="dot top-left"></span><span class="dot center"
                    ></span><span class="dot bottom-right"></span>
                </div>
                <!-- LEFT: 4 -->
                <div class="face left">
                    <span class="dot top-left"></span><span
                        class="dot top-right"></span>
                    <span class="dot bottom-left"></span><span
                        class="dot bottom-right"></span>
                </div>
            </div>
        </div>
        <span class="hint">Click to Roll</span>
    </button>
</div>

<script>
    // Correct rotations to show face X as "Front" (relative to camera)
    // Note: apply these to the Cube.

    const targetState = {
        1: { x: -25, y: -35 }, // Front (1) is already at 0,0. Add Iso offset.
        // Wait, if 1 is Front, and we want to SHOW 1 in Iso view:
        // We just rotate to Iso (-25, -35).

        // If we want to show 6 (Back):
        // We need to rotate 180 Y.
        // So final angle = (-25, -35 + 180) = (-25, 145)
        6: { x: -25, y: 145 },

        // Show 2 (Top):
        // Top is at RotateX(90). To bring it to front, we rotate Cube RotateX(-90).
        // Add Iso: (-25 - 90, -35) = (-115, -35)
        2: { x: -115, y: -35 },

        // Show 5 (Bottom):
        // Bottom is RotateX(-90). Bring to front -> RotateX(90).
        // Add Iso: (-25 + 90, -35) = (65, -35)
        5: { x: 65, y: -35 },

        // Show 3 (Right):
        // Right is RotateY(90). Bring to front -> RotateY(-90).
        // Add Iso: (-25, -35 - 90) = (-25, -125)
        3: { x: -25, y: -125 },

        // Show 4 (Left):
        // Left is RotateY(-90). Bring to front -> RotateY(90).
        // Add Iso: (-25, -35 + 90) = (-25, 55)
        4: { x: -25, y: 55 },
    };

    function setupDice(container) {
        const btn = container.querySelector(".roll-btn");
        const cube = container.querySelector(".cube");

        btn.addEventListener("click", () => {
            if (cube.classList.contains("tumbling")) return;

            // 1. Tumble
            cube.classList.remove("is-isometric");
            cube.style.transition = "none";
            cube.classList.add("tumbling");

            // 2. Decide
            const result = Math.floor(Math.random() * 6) + 1;
            const target = targetState[result];

            // 3. Land
            setTimeout(() => {
                cube.classList.remove("tumbling");
                // Match the CSS transition duration (2.5s)
                cube.style.transition =
                    "transform 2.5s cubic-bezier(0.19, 1, 0.22, 1)";

                // Apply final rotation
                cube.style.transform = `rotateX(${target.x}deg) rotateY(${target.y}deg)`;
            }, 800); // Wait bit for tumble to spin up
        });
    }

    document.querySelectorAll(".interactive-dice-container").forEach(setupDice);
</script>
