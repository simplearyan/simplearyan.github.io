---
interface Props {
    data: number[][]; // 2D array of values (e.g. probabilities or correlation)
    rowLabels?: string[];
    colLabels?: string[];
    width?: number;
    height?: number;
    colorBase?: string; // HSL Hue or Hex? We'll use simple opacity on a base color
}

const {
    data,
    rowLabels = [],
    colLabels = [],
    width = 300,
    height = 300,
    colorBase = "59, 130, 246", // RGB for #3b82f6 (Tailwind Blue-500)
} = Astro.props;

const rows = data.length;
const cols = data[0]?.length || 0;

const cellWidth = (width - 40) / cols;
const cellHeight = (height - 40) / rows;
const startX = 40; // Space for row labels
const startY = 0; // Col labels go above? Let's put them on bottom or top.
// Actually let's assume labels need space.
const margin = { top: 20, right: 0, bottom: 20, left: 50 };

const gridWidth = width - margin.left - margin.right;
const gridHeight = height - margin.top - margin.bottom;
const cw = gridWidth / cols;
const ch = gridHeight / rows;

// Find max value for normalization
const flatData = data.flat();
const maxVal = Math.max(...flatData) || 1;
---

<div
    class="heatmap-container"
    style={`width: ${width}px; height: ${height}px;`}
>
    <svg width="100%" height="100%" viewBox={`0 0 ${width} ${height}`}>
        {
            data.map((row, r) =>
                row.map((val, c) => {
                    const opacity = val / maxVal; // Normalize
                    return (
                        <g>
                            <rect
                                x={margin.left + c * cw}
                                y={margin.top + r * ch}
                                width={cw - 2}
                                height={ch - 2}
                                fill={`rgba(${colorBase}, ${opacity})`}
                                rx="2"
                            >
                                <title>Val: {val}</title>
                            </rect>
                            <text
                                x={margin.left + c * cw + cw / 2}
                                y={margin.top + r * ch + ch / 2 + 4}
                                text-anchor="middle"
                                fill={
                                    opacity > 0.5
                                        ? "white"
                                        : "var(--color-text)"
                                }
                                font-size="10"
                                pointer-events="none"
                            >
                                {val}
                            </text>
                        </g>
                    );
                }),
            )
        }

        <!-- Row Labels -->
        {
            rowLabels.map((lbl, i) => (
                <text
                    x={margin.left - 5}
                    y={margin.top + i * ch + ch / 2 + 4}
                    text-anchor="end"
                    fill="var(--color-text)"
                    font-size="11"
                    font-weight="bold"
                >
                    {lbl}
                </text>
            ))
        }

        <!-- Col Labels -->
        {
            colLabels.map((lbl, i) => (
                <text
                    x={margin.left + i * cw + cw / 2}
                    y={margin.top - 5}
                    text-anchor="middle"
                    fill="var(--color-text)"
                    font-size="11"
                    font-weight="bold"
                >
                    {lbl}
                </text>
            ))
        }
    </svg>
</div>

<style>
    .heatmap-container {
        display: inline-block;
        margin: 10px;
        font-family: var(--font-sans);
    }
</style>
