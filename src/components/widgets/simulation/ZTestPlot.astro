---
interface Props {
    zScore: number;
    tail?: "left" | "right" | "two-sided" | "two";
    width?: number;
    height?: number;
}

const { zScore, tail = "right", width = 400, height = 200 } = Astro.props;

// Standard Normal PDF
const pdf = (x: number) =>
    (1 / Math.sqrt(2 * Math.PI)) * Math.exp(-0.5 * x * x);

// Generate path data
const xMin = -4;
const xMax = 4;
const steps = 100;
const points = [];
let maxY = pdf(0);

for (let i = 0; i <= steps; i++) {
    const x = xMin + (i / steps) * (xMax - xMin);
    const y = pdf(x);
    points.push({ x, y });
}

// Convert to SVG coords
const padding = { bottom: 30, top: 20, left: 0, right: 0 };
const plotH = height - padding.bottom;
const plotW = width;

const scaleX = (val: number) => ((val - xMin) / (xMax - xMin)) * plotW;
const scaleY = (val: number) =>
    plotH - (val / maxY) * (plotH * 0.8) + padding.top;

let d = `M ${scaleX(points[0].x)} ${scaleY(points[0].y)}`;
points.forEach((p) => {
    d += ` L ${scaleX(p.x)} ${scaleY(p.y)}`;
});

// Shading Logic
const getShadePath = (condition: (x: number) => boolean) => {
    let path = "";
    let started = false;

    // Find points satisfying condition
    const validPoints = points.filter((p) => condition(p.x));

    if (validPoints.length === 0) return "";

    const startP = validPoints[0];
    const endP = validPoints[validPoints.length - 1];

    path = `M ${scaleX(startP.x)} ${plotH}`; // Start at axis
    path += ` L ${scaleX(startP.x)} ${scaleY(startP.y)}`; // Up to curve

    validPoints.forEach((p) => {
        path += ` L ${scaleX(p.x)} ${scaleY(p.y)}`;
    });

    path += ` L ${scaleX(endP.x)} ${plotH} Z`; // Down to axis and close
    return path;
};

let shadePath = "";
if (tail === "left") shadePath = getShadePath((x) => x < zScore);
else if (tail === "right") shadePath = getShadePath((x) => x > zScore);
else if (tail === "two" || tail === "two-sided") {
    const absZ = Math.abs(zScore);
    shadePath =
        getShadePath((x) => x < -absZ) + " " + getShadePath((x) => x > absZ);
}
---

<div class="ztest-container" style={`width: ${width}px; height: ${height}px;`}>
    <svg width="100%" height="100%" viewBox={`0 0 ${width} ${height}`}>
        <!-- Baseline -->
        <line
            x1="0"
            y1={plotH}
            x2={width}
            y2={plotH}
            stroke="var(--color-text)"
            stroke-width="2"></line>

        <!-- Shaded Area -->
        <path d={shadePath} fill="#ef4444" opacity="0.4"></path>

        <!-- Main Curve -->
        <path d={d} fill="none" stroke="var(--color-text)" stroke-width="2"
        ></path>

        <!-- Z-score Line -->
        <line
            x1={scaleX(zScore)}
            y1={plotH}
            x2={scaleX(zScore)}
            y2={scaleY(pdf(zScore))}
            stroke="#ef4444"
            stroke-width="2"
            stroke-dasharray="4"></line>

        <!-- Labels -->
        <text
            x={scaleX(0)}
            y={plotH + 20}
            text-anchor="middle"
            font-size="12"
            fill="var(--color-text)">0</text
        >
        <text
            x={scaleX(zScore)}
            y={plotH + 20}
            text-anchor="middle"
            font-weight="bold"
            fill="#ef4444">{zScore}</text
        >

        <!-- Tail Label -->
        <text
            x={width - 10}
            y={30}
            text-anchor="end"
            font-size="12"
            fill="#ef4444"
        >
            Shaded Area = P-value
        </text>
    </svg>
</div>

<style>
    .ztest-container {
        display: inline-block;
        margin: 10px;
        font-family: var(--font-sans);
        background: var(--color-code-bg);
        border-radius: 8px;
    }
</style>
