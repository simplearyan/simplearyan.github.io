---
interface Props {
    outcome?: "heads" | "tails";
    size?: number;
    color?: string; // Gold, Silver, Bronze
    animate?: boolean;
}

const {
    outcome = "heads",
    size = 80,
    color = "gold",
    animate = false,
} = Astro.props;

const colors = {
    gold: { base: "#FFD700", shade: "#DAA520", text: "#B8860B" },
    silver: { base: "#C0C0C0", shade: "#A9A9A9", text: "#696969" },
    bronze: { base: "#CD7F32", shade: "#8B4513", text: "#8B4513" },
};

const theme = colors[color] || colors.gold;
---

<div
    class="coin-scene"
    style={`width: ${size}px; height: ${size}px; perspective: 1000px;`}
>
    <div
        class={`coin ${animate ? "flipping" : ""} ${outcome}`}
        style={`
        width: 100%; 
        height: 100%;
        --base-color: ${theme.base};
        --shade-color: ${theme.shade};
        --text-color: ${theme.text};
    `}
    >
        <div class="face heads">
            <div class="content">H</div>
        </div>
        <div class="face tails">
            <div class="content">T</div>
        </div>
    </div>
</div>

<style>
    .coin-scene {
        display: inline-block;
        margin: 10px;
    }

    .coin {
        position: relative;
        width: 100%;
        height: 100%;
        transition: transform 1s ease-out;
        transform-style: preserve-3d;
    }

    .coin.heads {
        transform: rotateY(0deg);
    }

    .coin.tails {
        transform: rotateY(180deg);
    }

    .coin.flipping {
        animation: flip 2s infinite linear;
    }

    .face {
        position: absolute;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: radial-gradient(
            circle at 30% 30%,
            var(--base-color),
            var(--shade-color)
        );
        border: 4px solid var(--shade-color);
        display: flex;
        align-items: center;
        justify-content: center;
        backface-visibility: hidden;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
    }

    .heads {
        transform: rotateY(0deg);
    }

    .tails {
        transform: rotateY(180deg);
    }

    .content {
        font-family: "Playfair Display", serif;
        font-weight: 700;
        font-size: 2.5rem;
        color: var(--text-color);
        text-shadow: 1px 1px 0 rgba(255, 255, 255, 0.4);
    }

    @keyframes flip {
        0% {
            transform: rotateY(0deg);
        }
        100% {
            transform: rotateY(720deg);
        } /* 2 Full spins */
    }
</style>
