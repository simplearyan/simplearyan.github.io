---
interface Props {
    title: string;
    subtitle?: string;
    href: string;
    color?: string;
    icon?: string;
    index?: number;
}

const {
    title,
    subtitle,
    href,
    color = "#000",
    icon = "●",
    index = 1,
} = Astro.props;
const displayIndex = (index < 10 ? "0" : "") + index;
---

<a href={href} class="swiss-card" style={`--accent-color: ${color}`}>
    <div class="card-header">
        <span class="index">{displayIndex}</span>
        <div class="icon-pill">
            <span class="icon">{icon}</span>
        </div>
    </div>

    <div class="card-body">
        <h3>{title}</h3>
        <div class="divider"></div>
        {subtitle && <p>{subtitle}</p>}
    </div>

    <div class="hover-indicator"></div>
</a>

<style>
    .swiss-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%;
        min-height: 200px;
        background: var(--color-surface);
        border: 3px solid var(--color-text);
        padding: 1.5rem;
        text-decoration: none;
        color: var(--color-text);
        position: relative;
        transition:
            transform 0.15s ease,
            box-shadow 0.15s ease;
        box-shadow: 8px 8px 0px var(--color-text);
    }

    .swiss-card:hover {
        transform: translate(4px, 4px);
        box-shadow: 4px 4px 0px var(--color-text);
    }

    .swiss-card:active {
        transform: translate(8px, 8px);
        box-shadow: 0px 0px 0px var(--color-text);
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 2rem;
    }

    .index {
        font-family: "Helvetica Neue", "Arial", sans-serif;
        font-weight: 900;
        font-size: 2rem;
        line-height: 1;
        opacity: 0.2;
    }

    .icon-pill {
        background: var(--color-text);
        color: var(--color-surface);
        padding: 0.25rem 0.75rem;
        border-radius: 99px;
        font-size: 0.9rem;
    }

    .card-body h3 {
        font-family: "Playfair Display", serif;
        font-size: 1.75rem;
        line-height: 1.1;
        margin: 0 0 1rem 0;
        font-weight: 700;
    }

    .divider {
        width: 40px;
        height: 3px;
        background: var(--accent-color);
        margin-bottom: 1rem;
        transition: width 0.3s ease;
    }

    .swiss-card:hover .divider {
        width: 100%;
    }

    .card-body p {
        font-family: "Inter", sans-serif;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin: 0;
        opacity: 0.7;
    }

    :global([data-theme="dark"]) .swiss-card {
        border-color: var(--color-text);
        box-shadow: 8px 8px 0px var(--accent-color);
    }

    :global([data-theme="dark"]) .swiss-card:hover {
        box-shadow: 4px 4px 0px var(--accent-color);
    }

    :global([data-theme="dark"]) .icon-pill {
        background: var(--accent-color);
        color: white;
    }
</style>
