---
import { formatDate } from "@/utils";

interface Props {
    title: string;
    description: string;
    date: Date;
    image?: string;
    href: string;
    tags?: string[];
    lightColor?: string;
    darkColor?: string;
}

const {
    title,
    description,
    date,
    image,
    href,
    tags = [],
    lightColor,
    darkColor,
} = Astro.props;

const cardStyle = lightColor
    ? {
          "--card-bg-light": lightColor,
          "--card-bg-dark": darkColor || lightColor, // Fallback if no dark specific
      }
    : {};
---

<a href={href} class="blog-card group" style={cardStyle}>
    <div class={`image-container ${!image ? "placeholder" : ""}`}>
        {image && <img src={image} alt={title} loading="lazy" />}
        <div class="overlay"></div>
        {tags.length > 0 && <span class="floating-tag">{tags[0]}</span>}
    </div>
    <div class="content">
        <!-- <div class="meta">
            <time datetime={date.toISOString()}>{formatDate(date)}</time>
        </div> -->
        <h3 class="title">{title}</h3>
        <!-- <p class="description">{description}</p> -->
    </div>
</a>

<style>
    .blog-card {
        display: flex;
        flex-direction: column;
        background: var(--card-bg-light, var(--color-surface));
        /* Remove rounded corners for clipping feel */
        border-radius: 0;
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;
        /* Dashed border implies 'cut out' */
        border: 1px dashed var(--color-border);
        height: 100%;
        position: relative;
        /* Padding to simulate margin of a column */
        padding: 0.5rem;
    }

    /* Dark mode override */
    :global([data-theme="dark"]) .blog-card {
        background: var(--card-bg-dark, var(--color-surface));
        border: 1px dashed rgba(255, 255, 255, 0.2);
    }

    .blog-card:hover {
        /* Slight lift, but stiffer */
        transform: translateY(-2px);
        box-shadow: 4px 4px 0px var(--color-border);
        border-style: solid; /* Becomes solid on hover */
        z-index: 10;
        background: var(--color-bg);
    }

    .image-container {
        position: relative;
        width: 100%;
        aspect-ratio: 16/9;
        overflow: hidden;
        /* Sepia filter for all images by default for vintage feel? Maybe too strong. 
           Let's just filter saturation slightly. */
        filter: grayscale(0.2) sepia(0.1);
        transition: filter 0.3s ease;
        border-bottom: 3px double var(--color-border);
    }

    .blog-card:hover .image-container {
        filter: none; /* Restore color on hover */
    }

    .image-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .blog-card:hover .image-container img {
        transform: scale(1.02);
    }

    .overlay {
        position: absolute;
        inset: 0;
        /* Grainy overlay */
        background-color: rgba(0, 0, 0, 0.05); /* Slight tint */
        pointer-events: none;
    }

    .floating-tag {
        position: absolute;
        top: 0;
        right: 0;
        background: var(--color-text);
        color: var(--color-bg);
        padding: 0.25rem 0.75rem;
        /* Square tag */
        border-radius: 0;
        font-weight: 700;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        z-index: 2;
        font-family: var(--font-barlow);
    }

    :global([data-theme="dark"]) .floating-tag {
        background: var(--color-primary);
        color: #111;
    }

    .content {
        padding: 1rem 0.5rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        gap: 0.5rem;
        /* Transparent bg so card bg shows */
        background-color: transparent;
    }

    .meta {
        /* display: flex; */
        /* justify-content: space-between; */
        /* align-items: center; */
        font-size: 0.75rem;
        color: var(--color-text-muted);
        text-transform: uppercase;
        font-family: var(--font-mono);
        letter-spacing: 1px;
        border-bottom: 1px solid var(--color-border);
        padding-bottom: 0.25rem;
        margin-bottom: 0.25rem;
        display: inline-block;
        width: max-content;
    }

    .title {
        font-family: "Playfair Display", serif;
        font-size: 1.6rem;
        font-weight: 700;
        line-height: 1.1;
        margin: 0;
        color: var(--color-text);
        transition: color 0.2s ease;
        /* Implied ink bleed on titles */
        /* filter: url(#ink-bleed); */
    }

    .blog-card:hover .title {
        text-decoration: underline;
        text-decoration-thickness: 2px;
        text-underline-offset: 2px;
    }

    .description {
        font-family: "Carrois Gothic", sans-serif;
        font-size: 0.95rem;
        color: var(--color-text);
        line-height: 1.4;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 4; /* Show a bit more text */
        -webkit-box-orient: vertical;
        overflow: hidden;
        flex-grow: 1;
        opacity: 0.85;
        text-align: justify; /* Newspaper column justification */
    }

    /* Placeholder Pattern */
    .image-container.placeholder {
        background-color: var(--color-bg-offset);
        background-image: repeating-linear-gradient(
            45deg,
            var(--color-border) 0,
            var(--color-border) 1px,
            transparent 0,
            transparent 50%
        );
        background-size: 10px 10px;
    }
</style>
