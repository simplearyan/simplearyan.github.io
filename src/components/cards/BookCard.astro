---
interface Props {
    title: string;
    subtitle: string;
    href: string;
    coverColor?: string;
    pattern?: "circles" | "grid" | "waves" | "dots";
    fontStyle?: "serif" | "sans" | "display" | "handwritten";
    layoutStyle?: "classic" | "minimal" | "modern";
    orientation?: "vertical" | "horizontal";
}

const {
    title,
    subtitle,
    href,
    coverColor = "#3b82f6",
    pattern = "circles",
    fontStyle = "serif",
    layoutStyle = "classic",
    orientation = "vertical",
} = Astro.props;
---

<a href={href} class="book-card-link" data-orientation={orientation}>
    <div
        class="book-card"
        data-layout={layoutStyle}
        data-orientation={orientation}
    >
        <div
            class="book-cover"
            style={`background: linear-gradient(135deg, ${coverColor}, ${coverColor}dd)`}
            data-pattern={pattern}
            data-font={fontStyle}
        >
            <div class="book-spine"></div>
            <div class="book-content">
                <h3 class="book-title">{title}</h3>
                <!-- <p class="book-subtitle">{subtitle}</p> -->
                <div class="book-badge" style={`border-color: ${coverColor}40`}>
                    TEXTBOOK
                </div>
            </div>
            <div class="book-decor"></div>
        </div>
        <div class="book-pages"></div>
    </div>
</a>

<style>
    .book-card-link {
        text-decoration: none;
        display: block;
        width: 100%;
        /* Ensure the card doesn't get too small or too huge */
        min-width: 120px; /* Reduced from 140px for mobile */
        max-width: 200px;
        margin: 0 auto;
        perspective: 1000px;
        /* Container Query Setup */
        container-type: inline-size;
        container-name: book-card;
    }

    .book-card {
        position: relative;
        width: 100%;
        aspect-ratio: 2/3; /* Book aspect ratio */
        transition: transform 0.4s ease;
        transform-style: preserve-3d;
        transform: rotateY(-15deg) rotateX(5deg); /* More dramatic resting angle */
        box-shadow: 10px 10px 30px rgba(0, 0, 0, 0.3);
    }

    /* Mobile Responsive Tweak: Flatten angle to save space */
    @media (max-width: 600px) {
        .book-card {
            transform: rotateY(-5deg) rotateX(2deg);
        }
    }

    .book-card-link:hover .book-card {
        transform: rotateY(0deg) scale(1.02) translateY(-5px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    }

    .book-cover {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border-radius: 2px 4px 4px 2px;
        z-index: 10;
        /* Responsive padding linked directly to container width */
        padding: 8cqw;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        color: white;
        overflow: hidden;
        /* Cloth Texture Base */
        background-color: var(--cover-color, #333);
    }

    /* ... (rest of styles remain unchanged) ... */

    /* Cloth Texture Overlay */
    .book-cover::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.5' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.15'/%3E%3C/svg%3E");
        opacity: 0.6;
        mix-blend-mode: overlay;
        pointer-events: none;
        z-index: 1;
    }

    /* Spine Hinge Indentation */
    .book-cover::after {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: 10px;
        width: 2px;
        background: rgba(0, 0, 0, 0.3);
        box-shadow: 1px 0 1px rgba(255, 255, 255, 0.1);
        z-index: 2;
    }

    .book-spine {
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 16px;
        background: linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.3) 0%,
            rgba(0, 0, 0, 0.1) 20%,
            rgba(0, 0, 0, 0.2) 80%,
            rgba(0, 0, 0, 0.4) 100%
        );
        transform: rotateY(-90deg) translateX(-16px);
        transform-origin: left;
        z-index: 5;
        background-color: var(--cover-color, #333);
    }

    .book-content {
        position: relative;
        z-index: 30;
        margin-left: 0.5rem;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        border: 2px solid rgba(197, 160, 89, 0.4); /* Gold border */
        padding: 0.5rem;
        justify-content: center;
    }

    /* Gold Foil Title */
    .book-title {
        font-family: "Cinzel", serif;
        font-size: 10cqw !important;
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 0.5rem;

        color: #e5c17d; /* Gold base */
        background: linear-gradient(
            to bottom right,
            #fceeb5 0%,
            #e5c17d 50%,
            #9e7f3c 100%
        );
        -webkit-background-clip: text;
        background-clip: text;
        /* Transparent text for gradient, but fallback needed for shadow */
        color: transparent;

        text-shadow: 0px 1px 2px rgba(0, 0, 0, 0.5); /* Embossed shadow */
        letter-spacing: 0.05em;
    }

    /* Fallback for text-shadow on transparent text (often tricky), using simpler gold */
    @supports (-webkit-background-clip: text) {
        .book-title {
            text-shadow: none;
            filter: drop-shadow(0px 1px 1px rgba(0, 0, 0, 0.5));
        }
    }

    .book-badge {
        font-family: "Oswald", sans-serif;
        font-size: 5cqw;
        letter-spacing: 0.2em;
        color: rgba(197, 160, 89, 0.8); /* Gold */
        margin-top: auto;
        text-transform: uppercase;
        border-top: 1px solid rgba(197, 160, 89, 0.4);
        padding-top: 0.5rem;
        width: 100%;
    }

    /* Patterns */
    .book-decor {
        display: none; /* Simplify for vintage look */
    }

    /* Pages effect - old yellowed paper */
    .book-pages {
        position: absolute;
        top: 3px;
        right: -12px;
        width: 14px;
        height: calc(100% - 6px);
        background: #f4e4bc; /* Yellowed paper */
        border-radius: 0 2px 2px 0;
        box-shadow:
            inset 0 0 5px rgba(0, 0, 0, 0.2),
            5px 5px 15px rgba(0, 0, 0, 0.3);
        z-index: 0;
        transform: translateZ(-1px); /* Push behind cover slightly */
    }

    /* Page striations */
    .book-pages::before {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        width: 100%;
        background: repeating-linear-gradient(
            90deg,
            transparent,
            transparent 1px,
            rgba(0, 0, 0, 0.1) 2px,
            rgba(0, 0, 0, 0.05) 3px
        );
    }
</style>
