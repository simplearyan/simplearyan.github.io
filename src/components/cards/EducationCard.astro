---
import "@styles/education-card.css";

interface Props {
    title: string;
    description: string;
    date: Date;
    image?: string;
    href: string;
    institution: string;
    courseType: string;
    tags?: string[];
    cardColor?: string;
}

const {
    title,
    description,
    date,
    image,
    href,
    institution,
    courseType,
    tags = [],
    cardColor,
} = Astro.props;

// Color mapping for course types
// Color mapping for course types (Pastel Shades)
const getCategoryColor = (type: string) => {
    const normalizedType = type.toLowerCase();
    if (normalizedType.includes("degree")) return "#60a5fa"; // Pastel Blue (slightly deeper for text/border visibility)
    if (normalizedType.includes("course")) return "#a78bfa"; // Pastel Purple
    if (normalizedType.includes("certification")) return "#fb923c"; // Pastel Orange
    if (normalizedType.includes("foundation")) return "#f87171"; // Pastel Red
    return "#4ade80"; // Pastel Green
};

const finalColor = cardColor || getCategoryColor(courseType);

// Check if the course is new (less than 30 days old)
const isNew =
    (new Date().getTime() - new Date(date).getTime()) / (1000 * 3600 * 24) < 30;
---

<a
    href={href}
    class="education-card group"
    data-title={title}
    data-date={date.toISOString()}
    data-category={courseType}
    data-tags={tags.join(",")}
    style={`--category-color: ${finalColor};`}
>
    <!-- Top Accent Line is handled by CSS ::before -->

    <div class="card-header">
        <div class="institution-badge">
            <span class="institution">{institution}</span>
            <span class="separator">•</span>
            <span class="course-type">{courseType}</span>
        </div>
        {isNew && <span class="new-indicator">NEW</span>}
    </div>

    <div class="card-body">
        <h3 class="title">{title}</h3>
        <p class="description">{description}</p>
        <div class="card-footer">
            <span class="view-course">View Course &rarr;</span>
        </div>
    </div>

    <!-- Hover overlay handled by CSS ::after -->
</a>
