---
interface Props {
    title: string;
    href: string;
    color?: string;
    icon?: string;
    subtitle?: string;
    index?: number;
}

const {
    title,
    href,
    color = "var(--color-primary)",
    icon,
    subtitle,
    index = 0,
} = Astro.props;
---

<a
    href={href}
    class="enhanced-subject-card group"
    style={`--card-accent: ${color}; --animation-delay: ${index * 0.1}s`}
>
    <div class="card-background"></div>
    <div class="card-content">
        <div class="icon-container">
            {
                icon ? (
                    <span class="icon">{icon}</span>
                ) : (
                    <div class="default-icon" />
                )
            }
        </div>
        <div class="text-content">
            <h3 class="title">{title}</h3>
            {subtitle && <p class="subtitle">{subtitle}</p>}
        </div>
        <div class="action-icon">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="arrow-icon"
            >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
        </div>
    </div>
</a>

<style>
    .enhanced-subject-card {
        position: relative;
        display: block;
        text-decoration: none;
        color: inherit;
        border-radius: 16px;
        overflow: hidden;
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) backwards;
        animation-delay: var(--animation-delay);
        background: var(--color-surface);
        border: 1px solid var(--color-border);
    }

    @keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .card-background {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            135deg,
            color-mix(in srgb, var(--card-accent) 5%, transparent) 0%,
            transparent 100%
        );
        opacity: 0;
        transition: opacity 0.4s ease;
        z-index: 0;
    }

    .enhanced-subject-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px -8px color-mix(in srgb, var(--card-accent) 20%, transparent);
        border-color: color-mix(
            in srgb,
            var(--card-accent) 40%,
            var(--color-border)
        );
    }

    .enhanced-subject-card:hover .card-background {
        opacity: 1;
    }

    .card-content {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        padding: 1.5rem;
        gap: 1.25rem;
    }

    .icon-container {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: color-mix(
            in srgb,
            var(--card-accent) 10%,
            var(--color-surface)
        );
        border-radius: 12px;
        font-size: 1.5rem;
        color: var(--card-accent);
        border: 1px solid
            color-mix(in srgb, var(--card-accent) 20%, transparent);
        transition: all 0.3s ease;
    }

    .enhanced-subject-card:hover .icon-container {
        background: var(--card-accent);
        color: white;
        transform: scale(1.1) rotate(5deg);
        box-shadow: 0 4px 12px
            color-mix(in srgb, var(--card-accent) 40%, transparent);
    }

    .text-content {
        flex: 1;
    }

    .title {
        font-family: var(--font-sans);
        font-weight: 700;
        font-size: 1.1rem;
        margin: 0;
        color: var(--color-heading);
        line-height: 1.3;
        transition: color 0.3s ease;
    }

    .subtitle {
        font-size: 0.85rem;
        color: var(--color-text-muted);
        margin: 0.25rem 0 0 0;
        font-family: var(--font-sans);
    }

    .enhanced-subject-card:hover .title {
        color: var(--card-accent);
    }

    .action-icon {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: var(--color-bg);
        color: var(--color-text-muted);
        transition: all 0.3s ease;
        opacity: 0.6;
    }

    .enhanced-subject-card:hover .action-icon {
        background: var(--card-accent);
        color: white;
        opacity: 1;
        transform: translateX(4px);
    }

    /* Dark Mode Adjustments */
    :global([data-theme="dark"]) .enhanced-subject-card {
        background: linear-gradient(
            to bottom right,
            var(--color-surface),
            color-mix(in srgb, var(--color-surface), white 2%)
        );
        border-color: rgba(255, 255, 255, 0.08);
    }

    :global([data-theme="dark"]) .action-icon {
        background: rgba(255, 255, 255, 0.05);
    }
</style>
