---
interface Props {
    title: string;
    subtitle: string;
    href: string;
    coverColor?: string;
    pattern?: "circles" | "grid" | "waves" | "dots";
    fontStyle?: "serif" | "sans" | "display" | "handwritten";
    layoutStyle?: "classic" | "minimal" | "modern";
}

const {
    title,
    subtitle,
    href,
    coverColor = "#3b82f6",
    pattern = "circles",
    fontStyle = "serif",
    layoutStyle = "classic",
} = Astro.props;
---

<a href={href} class="book-card-link">
    <div class="book-card" data-layout={layoutStyle}>
        <div
            class="book-cover"
            style={`background: linear-gradient(135deg, ${coverColor}, ${coverColor}dd)`}
            data-pattern={pattern}
            data-font={fontStyle}
        >
            <div class="book-spine"></div>
            <div class="book-content">
                <h3 class="book-title">{title}</h3>
                <!-- <p class="book-subtitle">{subtitle}</p> -->
                <div class="book-badge" style={`border-color: ${coverColor}40`}>
                    TEXTBOOK
                </div>
            </div>
            <div class="book-decor"></div>
        </div>
        <div class="book-pages"></div>
    </div>
</a>

<style>
    .book-card-link {
        text-decoration: none;
        display: block;
        width: 100%;
        /* Ensure the card doesn't get too small or too huge */
        min-width: 120px;
        max-width: 180px;
        margin: 0 auto;
        perspective: 1000px;
        /* Container Query Setup */
        container-type: inline-size;
        container-name: book-card;
    }

    .book-card {
        position: relative;
        width: 100%;
        aspect-ratio: 2/3; /* Book aspect ratio */
        transition: transform 0.3s ease;
        transform-style: preserve-3d;
        transform: rotateY(-3deg);
    }

    .book-card-link:hover .book-card {
        transform: rotateY(0deg) scale(1.02) translateY(-5px);
    }

    .book-cover {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border-radius: 4px 8px 8px 4px;
        box-shadow:
            -1px 2px 4px rgba(0, 0, 0, 0.1),
            /* Spine */ 5px 5px 15px rgba(0, 0, 0, 0.15); /* Drop shadow */
        z-index: 10;
        /* Responsive padding linked directly to container width */
        padding: 7cqw;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        color: white;
        overflow: hidden;
    }

    .book-spine {
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 12px;
        background: linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.2) 0%,
            rgba(255, 255, 255, 0) 20%,
            rgba(0, 0, 0, 0.1) 100%
        );
        z-index: 20;
        border-right: 1px solid rgba(0, 0, 0, 0.1);
    }

    .book-content {
        position: relative;
        z-index: 30;
        margin-left: 0.5rem;
    }

    .book-title {
        font-family: "Cinzel", serif;
        /* Base proportional font size */
        font-size: 11cqw !important;
        font-weight: 700;
        line-height: 1.15;
        margin-bottom: 0.5rem;
        /* margin-top:  !important; */
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
        word-wrap: break-word;
    }

    .book-subtitle {
        font-family: "Inter", sans-serif;
        font-size: 6.5cqw;
        opacity: 0.9;
        font-weight: 500;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.3;
    }

    .book-badge {
        font-family: "Oswald", sans-serif;
        font-size: 5cqw;
        letter-spacing: 0.15em;
        background: rgba(0, 0, 0, 0.2);
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        display: inline-block;
        margin-top: auto;
        backdrop-filter: blur(4px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    /* Adjustments for smaller cards */
    @container book-card (max-width: 180px) {
        .book-title {
            font-size: 9.5cqw; /* Reduced multiplier */
        }
        .book-subtitle {
            font-size: 5.5cqw;
        }
        .book-badge {
            font-size: 4.5cqw;
        }
    }

    /* Patterns */
    .book-decor {
        position: absolute;
        bottom: -20%;
        right: -20%;
        /* Responsive decor size */
        width: 60cqw;
        height: 60cqw;
        border: 2px solid rgba(255, 255, 255, 0.1);
        border-radius: 50%;
        pointer-events: none;
    }

    /* Circles Pattern (Default) */
    .book-cover[data-pattern="circles"] .book-decor {
        border-radius: 50%;
    }
    .book-cover[data-pattern="circles"]::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-image: radial-gradient(
            circle at 1px 1px,
            rgba(255, 255, 255, 0.1) 1px,
            transparent 0
        );
        background-size: 20px 20px;
        z-index: 1;
        pointer-events: none;
    }

    /* Grid Pattern */
    .book-cover[data-pattern="grid"] .book-decor {
        border-radius: 10%; /* Square-ish */
        border: 2px solid rgba(255, 255, 255, 0.1);
        transform: rotate(45deg);
    }
    .book-cover[data-pattern="grid"]::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-image: linear-gradient(
                rgba(255, 255, 255, 0.05) 1px,
                transparent 1px
            ),
            linear-gradient(
                90deg,
                rgba(255, 255, 255, 0.05) 1px,
                transparent 1px
            );
        background-size: 20px 20px;
        z-index: 1;
        pointer-events: none;
    }

    /* Waves Pattern */
    .book-cover[data-pattern="waves"] .book-decor {
        display: none;
    }
    .book-cover[data-pattern="waves"]::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: radial-gradient(
                circle at 100% 100%,
                transparent 20%,
                rgba(255, 255, 255, 0.05) 21%,
                transparent 22%
            ),
            radial-gradient(
                circle at 0% 0%,
                transparent 20%,
                rgba(255, 255, 255, 0.05) 21%,
                transparent 22%
            );
        background-size: 40px 40px;
        z-index: 1;
        pointer-events: none;
    }

    /* Refined Pages effect */
    .book-pages {
        position: absolute;
        top: 3px;
        right: -10px; /* Reduced specific thickness */
        width: 14px; /* More depth */
        height: calc(100% - 6px);
        background: #fdfdfd;
        border-radius: 0 3px 3px 0;
        box-shadow:
            inset 4px 0 8px rgba(0, 0, 0, 0.1),
            /* Shadow from cover */ inset -1px 0 2px rgba(0, 0, 0, 0.05),
            /* Edge definition */ 5px 5px 10px rgba(0, 0, 0, 0.1); /* External shadow */
        z-index: 0;
    }

    /* Paper Texture - Vertical striations for stacked pages */
    .book-pages::before {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        width: 100%;
        background: repeating-linear-gradient(
            90deg,
            transparent,
            transparent 1px,
            rgba(0, 0, 0, 0.03) 2px,
            rgba(0, 0, 0, 0.03) 3px
        );
    }

    /* Back cover hint */
    .book-pages::after {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 2px;
        height: 100%;
        background: rgba(0, 0, 0, 0.2);
        z-index: 1;
    }

    /* Font Styles */
    .book-cover[data-font="serif"] .book-title {
        font-family: "Cinzel", serif;
    }
    .book-cover[data-font="sans"] .book-title {
        font-family: "Montserrat", sans-serif;
        letter-spacing: -0.02em;
    }
    .book-cover[data-font="display"] .book-title {
        font-family: "Oswald", sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .book-cover[data-font="handwritten"] .book-title {
        font-family: "Kalam", cursive;
        letter-spacing: 0;
        line-height: 1;
    }

    /* Layout Styles: Minimal */
    .book-card[data-layout="minimal"] .book-cover {
        box-shadow: none;
        border: 1px solid rgba(0, 0, 0, 0.1);
    }
    .book-card[data-layout="minimal"] .book-spine,
    .book-card[data-layout="minimal"] .book-pages,
    .book-card[data-layout="minimal"] .book-decor {
        display: none;
    }
    .book-card[data-layout="minimal"] .book-badge {
        background: transparent;
        border: 1px solid white;
        backdrop-filter: none;
    }

    /* Layout Styles: Modern */
    .book-card[data-layout="modern"] .book-cover {
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }
    .book-card[data-layout="modern"] .book-spine {
        background: linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.4) 0%,
            transparent 100%
        );
        width: 4px;
    }
    .book-card[data-layout="modern"] .book-badge {
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(12px);
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        color: white;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    }

    /* Fallback / Fine-tuning for extremely small containers if needed */
    @container book-card (max-width: 140px) {
        .book-subtitle {
            -webkit-line-clamp: 2; /* Reduce lines on very small cards */
        }
    }
</style>
