---
interface Props {
    title: string;
    href: string;
    color?: string;
    icon?: string;
    subtitle?: string;
}

const {
    title,
    href,
    color = "var(--color-primary)",
    icon,
    subtitle,
} = Astro.props;
---

<a href={href} class="professional-card" style={`--accent-color: ${color}`}>
    <div class="card-content">
        <div class="icon-box">
            {
                icon ? (
                    <span class="icon">{icon}</span>
                ) : (
                    <div class="default-icon" />
                )
            }
        </div>
        <div class="text-content">
            <h3 class="title">{title}</h3>
            {subtitle && <p class="subtitle">{subtitle}</p>}
        </div>
        <div class="arrow-container">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="arrow"
            >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
        </div>
    </div>
</a>

<style>
    .professional-card {
        display: block;
        text-decoration: none;
        color: inherit;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-left: 4px solid var(--accent-color);
        border-radius: 12px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }

    .professional-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.15);
        border-color: color-mix(
            in srgb,
            var(--accent-color) 30%,
            var(--color-border)
        );
    }

    .card-content {
        display: flex;
        align-items: center;
        padding: 1.75rem;
        gap: 1.25rem;
        position: relative;
        z-index: 1;
    }

    .icon-box {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        background: color-mix(in srgb, var(--accent-color) 10%, transparent);
        color: var(--accent-color);
        border-radius: 12px;
        font-size: 1.75rem;
        border: 1px solid
            color-mix(in srgb, var(--accent-color) 20%, transparent);
        transition: all 0.3s ease;
    }

    .professional-card:hover .icon-box {
        background: var(--accent-color);
        color: white;
        transform: scale(1.05) rotate(3deg);
        box-shadow: 0 4px 12px
            color-mix(in srgb, var(--accent-color) 40%, transparent);
    }

    .text-content {
        flex: 1;
    }

    .title {
        font-family: "Playfair Display", serif;
        font-size: 1.35rem;
        font-weight: 700;
        margin: 0;
        color: var(--color-heading);
        line-height: 1.2;
        letter-spacing: -0.01em;
        transition: color 0.3s ease;
    }

    .professional-card:hover .title {
        color: var(--accent-color);
    }

    .subtitle {
        font-family: "Montserrat", sans-serif;
        font-size: 0.75rem;
        color: var(--color-text-muted);
        margin-top: 0.35rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .arrow-container {
        color: var(--color-text-muted);
        transition: all 0.3s ease;
        opacity: 0;
        transform: translateX(-10px);
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: color-mix(in srgb, var(--accent-color) 10%, transparent);
    }

    .professional-card:hover .arrow-container {
        transform: translateX(0);
        opacity: 1;
        color: var(--accent-color);
    }

    /* Dark mode adjustments */
    :global([data-theme="dark"]) .professional-card {
        background: color-mix(in srgb, var(--color-surface), white 2%);
        border-color: rgba(255, 255, 255, 0.08);
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
    }

    :global([data-theme="dark"]) .professional-card:hover {
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.4);
        background: color-mix(in srgb, var(--color-surface), white 4%);
    }
</style>
