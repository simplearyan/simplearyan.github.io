---
interface Props {
    title?: string;
}

const { title = "View Detailed Solution" } = Astro.props;

import katex from "katex";

const renderTitle = (text: string) => {
    return text.replace(/\$([^\$]+)\$/g, (_, match) => {
        try {
            return katex.renderToString(match, {
                throwOnError: false,
                displayMode: false,
            });
        } catch (e) {
            return match;
        }
    });
};
---

<details class="solution-details">
    <summary class="solution-summary">
        <span class="text" set:html={renderTitle(title)} />
        <span class="chevron">▼</span>
    </summary>
    <div class="solution-content">
        <slot />
    </div>
</details>

<style>
    .solution-details {
        margin-top: 1rem;
        border-top: 1px dashed var(--color-border);
        transition: all 0.3s ease;
    }

    .solution-details[open] {
        border-top: 1px solid var(--color-border);
        padding-bottom: 1rem;
    }

    .solution-summary {
        padding: 0.75rem 0;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 500;
        color: var(--color-primary); /* Use primary color for action */
        font-size: 0.9rem;
        font-family: var(--font-mono);
        transition: opacity 0.2s;
        user-select: none;
        list-style: none; /* Hide default marker */
    }

    .solution-summary::-webkit-details-marker {
        display: none;
    }

    .solution-summary:hover {
        opacity: 0.7;
    }

    .solution-summary .icon {
        font-size: 1.1em;
    }

    .solution-summary .chevron {
        margin-left: auto;
        font-size: 0.8rem;
        transition: transform 0.3s ease;
        opacity: 0.5;
    }

    .solution-details[open] .solution-summary .chevron {
        transform: rotate(180deg);
    }

    .solution-summary .text {
        font-size: 1rem;
        font-family: var(--font-carrois);
        text-transform: uppercase;
        color: var(--color-secondary);
    }                       

    .solution-content {
        background: transparent;
        padding: 0.5rem 0 0;
        color: var(--color-text);
        font-family: var(--font-carrois) !important;
        font-size: 1.2rem;
        animation: slideDown 0.3s ease-out;
    }

    @keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
