---
interface Props {
    placeholder?: string;
    label?: string;
}

const { placeholder = "Enter your answer...", label } = Astro.props;
---

<div class="short-answer-container">
    {label && <label class="input-label">{label}</label>}
    <div class="input-wrapper">
        <input
            type="text"
            class="handwritten-input"
            placeholder={placeholder}
        />
    </div>
</div>

<style>
    .short-answer-container {
        margin-top: 1.5rem;
        width: 100%;
    }

    .input-label {
        display: block;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--text-muted);
    }

    .input-wrapper {
        position: relative;
    }

    .handwritten-input {
        width: 100%;
        background: transparent;
        border: none;
        border-bottom: 2px dashed var(--input-border, #9ca3af);
        padding: 0.5rem 0;
        font-family: "Courier Prime", "Courier New", monospace;
        font-size: 1.25rem;
        color: var(--text-color);
        outline: none;
        transition: all 0.3s ease;
    }

    .handwritten-input:focus {
        border-bottom-style: solid;
        border-color: var(--primary-color, #a855f7);
        background-color: rgba(0, 0, 0, 0.02);
    }

    :global([data-theme="dark"]) .handwritten-input:focus {
        background-color: rgba(255, 255, 255, 0.02);
    }

    /* Simulating the "notebook" underline look */
    .handwritten-input::placeholder {
        color: var(--text-disabled, #d1d5db);
        font-family: var(--font-sans);
        font-style: italic;
        font-size: 1rem;
    }
</style>
