---
interface Props {
    variant?: "epic" | "noir" | "neon" | "retro" | "impact" | "hero";
    as?: "h1" | "h2" | "h3" | "p" | "span";
    class?: string;
    color?: string;
}

const {
    variant = "epic",
    as: Tag = "h2",
    class: className,
    color,
} = Astro.props;

const variants = {
    epic: "font-cinzel tracking-widest uppercase text-transparent bg-clip-text bg-gradient-to-b from-gray-200 to-gray-400 drop-shadow-lg",
    noir: "font-playfair tracking-wide uppercase text-white drop-shadow-[4px_4px_0_rgba(0,0,0,1)]", // Using Playfair as fallback/complement or custom font if available
    neon: "font-mono text-neon-pink drop-shadow-[0_0_10px_rgba(255,0,255,0.7)] uppercase tracking-wider",
    retro: "font-oswald uppercase tracking-tighter text-yellow-400 -skew-y-3 drop-shadow-[2px_2px_0_#d946ef]",
    impact: "font-oswald uppercase tracking-tight text-white text-6xl md:text-8xl font-bold italic",
    hero: "font-cinzel font-bold tracking-[0.2em] uppercase text-white drop-shadow-2xl",
    "comic-verse":
        "font-oswald font-bold uppercase tracking-tight text-white text-4xl md:text-5xl leading-tight",
};

// Custom styles for specific variants that need more than utility classes
const style = color ? `color: ${color};` : "";
---

<Tag
    class={`cinematic-text variant-${variant} ${variants[variant]} ${className || ""}`}
    style={style}
>
    <slot />
</Tag>

<style>
    /* Import fonts if they aren't globally available, though we added them to Layout */
    /* We rely on global classes, but adding specific tweak classes here */

    .variant-neon {
        text-shadow:
            0 0 5px #fff,
            0 0 10px #fe05e1,
            0 0 15px #fe05e1,
            0 0 20px #fe05e1;
        color: white;
    }

    .variant-noir {
        /* Hard shadow for noir look */
        text-shadow: 4px 4px 0px #000000;
    }

    .variant-epic {
        background-image: linear-gradient(to bottom, #f3f4f6, #9ca3af);
        -webkit-background-clip: text;
        color: transparent;
    }

    /* Glitch effect for Retro/Cyber */
    .variant-retro:hover {
        animation: glitch 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) both
            infinite;
    }

    @keyframes glitch {
        0% {
            transform: translate(0);
        }
        20% {
            transform: translate(-2px, 2px);
        }
        40% {
            transform: translate(-2px, -2px);
        }
        60% {
            transform: translate(2px, 2px);
        }
        80% {
            transform: translate(2px, -2px);
        }
        100% {
            transform: translate(0);
        }
    }
</style>
