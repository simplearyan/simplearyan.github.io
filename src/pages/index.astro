---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import EducationCard from "../components/EducationCard.astro";
import "../styles/education-card.css";

const posts = (await getCollection("blog"))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);
---

<Layout title="Home">
	<!-- <section class="hero animate-fade-in">
		<h1>
			<span class="civic">find</span>
			<span class="aryan">(solution)</span>
			<span class="logo-x">x</span>
		</h1>
		<p class="subtitle">A public notebook and learning hub.</p>
	</section> -->

	<section class="education-section hidden" id="education-section">
		<div class="section-header">
			<h2 class="section-title">Continue Learning</h2>
			<a href="/education" class="view-all">View All Courses</a>
		</div>
		<div class="education-grid" id="education-grid">
			{
				/* Server-side rendered 'New' courses */
				(await getCollection("education"))
					.filter((course) => {
						const isNew =
							(new Date().getTime() -
								new Date(course.data.pubDate).getTime()) /
								(1000 * 3600 * 24) <
							30;
						return isNew;
					})
					.slice(0, 3) // Limit to 3 new courses
					.map((course) => (
						<div class="education-card-wrapper">
							<EducationCard
								title={course.data.title}
								description={course.data.description}
								date={course.data.pubDate}
								image={course.data.image}
								href={`/education/${course.slug}`}
								institution={
									course.data.institution ||
									"Unknown Institution"
								}
								courseType={course.data.courseType || "Course"}
								tags={course.data.tags}
								cardColor={course.data.cardColor}
							/>
						</div>
					))
			}
		</div>
	</section>

	<div class="section-header">
		<h2 class="section-title">Read Blog</h2>
		<a href="/blog" class="view-all">View All Posts</a>
	</div>
	<section class="posts-grid">
		{
			posts.map((post, index) => {
				// 1. Pastel Palette (Light Mode)
				const pastelColors = [
					"#e0f2fe", // Light Sky
					"#fce7f3", // Light Pink
					"#dcfce7", // Light Green
					"#fef3c7", // Light Amber
					"#ede9fe", // Light Violet
					"#ffe4e6", // Light Rose
				];

				// 2. Dark Palette (Dark Mode)
				const darkColors = [
					"#0c4a6e", // Dark Sky
					"#831843", // Dark Pink
					"#14532d", // Dark Green
					"#78350f", // Dark Amber
					"#4c1d95", // Dark Violet
					"#881337", // Dark Rose
				];

				const colorIndex = index % pastelColors.length;
				let light = pastelColors[colorIndex];
				let dark = darkColors[colorIndex];

				if (post.data.cardColor) {
					light = post.data.cardColor;
					dark = "#1f2937"; // distinct fallback
				}

				return (
					<article
						class="post-card animate-fade-in"
						style={`--card-light: ${light}; --card-dark: ${dark};`}
					>
						<a href={`/blog/${post.slug}`}>
							<div class="post-content">
								<span class="post-date">
									{post.data.pubDate.toLocaleDateString(
										"en-US",
										{
											year: "numeric",
											month: "long",
											day: "numeric",
										},
									)}
								</span>
								<h2>{post.data.title}</h2>
								<p>{post.data.description}</p>
								<div class="post-tags">
									{post.data.tags.map((tag) => (
										<span class="tag">#{tag}</span>
									))}
								</div>
							</div>
						</a>
					</article>
				);
			})
		}
	</section>

	<script is:inline>
		// Client-side logic for Recently Opened courses
		(async () => {
			try {
				const recentlyViewed = JSON.parse(
					localStorage.getItem("recentlyViewedCourses") || "[]",
				);

				// Handle both array of strings (legacy) and array of objects
				const recentlyViewedSlugs = recentlyViewed
					.map((item) =>
						typeof item === "string" ? item : item.slug,
					)
					.slice(0, 4);

				if (recentlyViewedSlugs.length === 0) {
					// If no recent courses, just show the section if it has server-rendered content (New courses)
					const grid = document.getElementById("education-grid");
					if (grid && grid.children.length > 0) {
						document
							.getElementById("education-section")
							.classList.remove("hidden");
					}
					return;
				}

				// Fetch all courses data
				const response = await fetch("/api/courses.json");
				const allCourses = await response.json();

				// Filter for recently viewed courses
				const recentCourses = allCourses.filter((course) =>
					recentlyViewedSlugs.includes(course.slug),
				);

				// Get existing rendered cards (New courses) to avoid duplicates and mark them if recent
				const existingCards =
					document.querySelectorAll(".education-card");
				const existingSlugs = [];

				existingCards.forEach((card) => {
					const href = card.getAttribute("href");
					const slug = href ? href.split("/").pop() : "";
					existingSlugs.push(slug);

					if (recentlyViewedSlugs.includes(slug)) {
						card.classList.add("show-recent");
						const label = card.querySelector(
							".recently-opened-label",
						);
						if (label) label.style.display = "block";
					}
				});

				const coursesToAdd = recentCourses.filter(
					(course) => !existingSlugs.includes(course.slug),
				);

				if (coursesToAdd.length > 0) {
					const grid = document.getElementById("education-grid");
					const educationSection =
						document.getElementById("education-section");

					if (grid && educationSection) {
						educationSection.classList.remove("hidden");

						// Helper to get category color (Pastel Shades - replicated from EducationCard.astro)
						const getCategoryColor = (type) => {
							if (!type) return "#4ade80";
							const normalizedType = type.toLowerCase();
							if (normalizedType.includes("degree"))
								return "#60a5fa"; // Pastel Blue
							if (normalizedType.includes("course"))
								return "#a78bfa"; // Pastel Purple
							if (normalizedType.includes("certification"))
								return "#fb923c"; // Pastel Orange
							if (normalizedType.includes("foundation"))
								return "#f87171"; // Pastel Red
							return "#4ade80"; // Pastel Green
						};

						coursesToAdd.forEach((course) => {
							const data = course.data;
							const categoryColor =
								data.cardColor ||
								getCategoryColor(data.courseType || "Course");
							const href = `/education/${course.slug}`;

							const cardHTML = `
                                <a href="${href}" class="education-card group show-recent" style="--category-color: ${categoryColor};">
                                    <span class="recently-opened-label" style="display: block;">Opened Recently</span>
                                    <div class="card-header">
                                        <div class="institution-badge">
                                            <span class="institution">${data.institution || "Unknown Institution"}</span>
                                            <span class="course-type" style="color: ${categoryColor}">${data.courseType || "Course"}</span>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <h3 class="title">${data.title}</h3>
                                        <p class="description">${data.description}</p>
                                        <div class="tags">
                                            ${(data.tags || [])
												.slice(0, 3)
												.map(
													(tag) =>
														`<span class="tag">${tag}</span>`,
												)
												.join("")}
                                        </div>
                                    </div>
                                </a>
                            `;

							const wrapper = document.createElement("div");
							wrapper.className = "education-card-wrapper";
							wrapper.innerHTML = cardHTML;
							grid.appendChild(wrapper);
						});

						// Re-order all cards based on recentlyViewedSlugs
						const allWrappers = Array.from(grid.children);
						allWrappers.sort((a, b) => {
							const linkA = a.querySelector("a");
							const linkB = b.querySelector("a");
							const slugA = linkA
								? linkA.getAttribute("href").split("/").pop()
								: "";
							const slugB = linkB
								? linkB.getAttribute("href").split("/").pop()
								: "";

							const indexA = recentlyViewedSlugs.indexOf(slugA);
							const indexB = recentlyViewedSlugs.indexOf(slugB);

							// If both are recent, sort by index (lower index = more recent = first)
							if (indexA !== -1 && indexB !== -1)
								return indexA - indexB;

							// If only A is recent, it comes first
							if (indexA !== -1) return -1;

							// If only B is recent, it comes first
							if (indexB !== -1) return 1;

							// If neither are recent, keep original order (or sort by date if needed)
							return 0;
						});

						// Re-append in correct order
						allWrappers.forEach((wrapper) =>
							grid.appendChild(wrapper),
						);
					}
				} else {
					// Check if we should show the section anyway (if new courses exist)
					const grid = document.getElementById("education-grid");
					if (grid && grid.children.length > 0) {
						document
							.getElementById("education-section")
							.classList.remove("hidden");
					}
				}
			} catch (e) {
				console.error("Error loading recent courses:", e);
				// Fallback: show section if it has content
				const grid = document.getElementById("education-grid");
				if (grid && grid.children.length > 0) {
					document
						.getElementById("education-section")
						.classList.remove("hidden");
				}
			}
		})();
	</script>
</Layout>

<style>
	.hero {
		text-align: center;
		padding: var(--spacing-xl) 0;
		margin-bottom: var(--spacing-xl);
	}

	.hero h1 {
		font-size: 4rem;
		margin-bottom: var(--spacing-sm);
	}

	.highlight {
		color: var(--color-primary);
	}

	.subtitle {
		font-size: 1.25rem;
		color: #666;
		max-width: 600px;
		margin: 0 auto;
	}

	.aryan {
		font-family: "Playfair Display", serif;
		font-weight: 700;
		font-style: italic;
		letter-spacing: -0.05em;
		color: var(--color-secondary);
	}

	.logo-x {
		font-family: "Kalam", cursive;
		font-size: 2.4rem;
		font-weight: 700;
		margin-left: 0;
		transform: translateY(-22px) rotate(0deg);
		color: var(--color-text);
		display: inline-block;
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: var(--spacing-lg);
	}

	.post-card {
		background: var(--card-light, var(--color-bg));
		border: 1px solid var(--color-border);
		border-radius: 12px;
		overflow: hidden;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			border-color 0.2s ease;
	}

	:global([data-theme="dark"]) .post-card {
		background: var(--card-dark, var(--color-bg));
	}

	.post-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.1);
		border-color: var(--color-secondary);
	}

	.post-card a {
		display: block;
		height: 100%;
		padding: var(--spacing-lg);
		text-decoration: none;
		color: inherit;
	}

	.post-card a:hover {
		color: inherit;
	}

	.post-date {
		font-size: 0.85rem;
		color: var(--color-text);
		opacity: 0.8;
		display: block;
		margin-bottom: var(--spacing-sm);
		font-family: "Inter", sans-serif;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		font-weight: 500;
	}

	.post-card h2 {
		font-size: 1.5rem;
		margin-bottom: var(--spacing-sm);
		line-height: 1.3;
		font-family: "Outfit", sans-serif;
		font-weight: 700;
		color: var(--color-heading);
	}

	.post-card p {
		color: var(--color-text);
		font-size: 1.05rem;
		margin-bottom: var(--spacing-md);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		opacity: 0.9;
		line-height: 1.6;
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tag {
		font-size: 0.75rem;
		background-color: rgba(255, 255, 255, 0.6);
		padding: 0.35rem 0.85rem;
		border-radius: 9999px; /* Pill shape */
		color: var(--color-text);
		font-family: "Inter", sans-serif;
		font-weight: 500;
		border: 1px solid rgba(0, 0, 0, 0.05);
		transition: all 0.2s ease;
		letter-spacing: 0.02em;
	}

	.tag:hover {
		background-color: rgba(255, 255, 255, 0.9);
		transform: translateY(-1px);
	}

	:global([data-theme="dark"]) .tag {
		background-color: rgba(0, 0, 0, 0.3);
		border-color: rgba(255, 255, 255, 0.1);
	}

	:global([data-theme="dark"]) .tag:hover {
		background-color: rgba(0, 0, 0, 0.5);
	}

	@media (max-width: 768px) {
		.hero h1 {
			font-size: 2.5rem;
		}

		.logo-x {
			font-size: 1.5rem;
			transform: translateY(-14px) rotate(0deg);
			margin-left: 0;
		}

		.section-header {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.5rem;
		}
	}

	/* Education Section Styles */
	.education-section {
		margin-bottom: var(--spacing-xl);
		margin-top: var(--spacing-xl);
		padding-bottom: var(--spacing-xl);
		border-bottom: 1px solid var(--color-border);
	}

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: var(--spacing-lg);
	}

	.section-title {
		font-size: 2rem;
		/* font-family: var(--font-serif); */
		font-family: "Playfair Display", serif;
		margin-bottom: 0;
	}

	.view-all {
		/* font-family: var(--font-mono); */
		font-family: "Montserrat", sans-serif;
		font-family: "Playfair Display", serif;
		font-family: "Inter", sans-serif;
		font-size: 0.9rem;
		color: var(--color-primary);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.02em;
	}

	.education-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: var(--spacing-lg);
	}

	.education-card-wrapper {
		height: 100%;
	}

	@media (max-width: 1024px) {
		.education-grid {
			display: grid;
			grid-auto-flow: column;
			grid-auto-columns: min(340px, 85vw);
			overflow-x: auto;
			gap: 1.5rem;
			padding-bottom: 2rem; /* Space for scrollbar/shadow */

			/* Full bleed scrolling */
			margin-left: calc(var(--spacing-md) * -1);
			margin-right: calc(var(--spacing-md) * -1);
			padding-left: var(--spacing-md);
			padding-right: var(--spacing-md);

			-webkit-overflow-scrolling: touch;
		}

		.education-grid::-webkit-scrollbar {
			display: none;
		}

		.education-card-wrapper {
			height: 100%;
			display: flex;
			flex-direction: column;
		}

		.education-card-wrapper > .education-card {
			flex: 1;
		}
	}
</style>
