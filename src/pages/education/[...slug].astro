---
import { getCollection } from "astro:content";
import CourseLayout from "../../layouts/CourseLayout.astro";
import EducationSingleLayout from "../../layouts/EducationSingleLayout.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import HorizontalAd from "../../components/ads/HorizontalAd.astro";

import ThinHorizontalAd from "../../components/ads/ThinHorizontalAd.astro";
import MultiplexAd from "../../components/ads/MultiplexAd.astro";

export async function getStaticPaths() {
    const educationItems = await getCollection("education");
    return educationItems.map((item) => ({
        params: { slug: item.slug },
        props: item,
    }));
}

const item = Astro.props;
const { Content, headings } = await item.render();

const isCourseContent =
    item.data.type === "unit" ||
    item.data.type === "subject" ||
    item.data.type === "module";
const courseTag = item.data.tags ? item.data.tags[0] : "Data Science";

// Navigation Logic
const educationItems = await getCollection("education");
const currentCourseItems = educationItems
    .filter(
        (i) =>
            i.data.parent === item.data.parent && i.data.parent !== undefined,
    )
    .sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const currentIndex = currentCourseItems.findIndex((i) => i.slug === item.slug);
const prevLesson =
    currentIndex > 0 ? currentCourseItems[currentIndex - 1] : null;
const nextLesson =
    currentIndex < currentCourseItems.length - 1
        ? currentCourseItems[currentIndex + 1]
        : null;
---

{
    isCourseContent ? (
        <CourseLayout
            title={item.data.title}
            currentSlug={item.slug}
            courseTag={courseTag}
            courseTitle={courseTag}
            headings={headings}
            hideToc={item.data.hideToc}
        >
            <article
                class={`prose ${item.data.hideToc ? "max-w-75ch" : "max-w-75ch"}`}
            >
                <HorizontalAd />
                <div class="lesson-header">
                    <h1>{item.data.title}</h1>
                    <button
                        id="zen-mode-toggle"
                        class="zen-mode-btn"
                        aria-label="Toggle Zen Mode"
                        title="Toggle Zen Mode"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="zen-icon-enter"
                        >
                            <path d="M15 3h6v6" />
                            <path d="M9 21H3v-6" />
                            <path d="M21 3l-7 7" />
                            <path d="M3 21l7-7" />
                        </svg>
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="zen-icon-exit hidden"
                        >
                            <path d="M4 14h6v6" />
                            <path d="M20 10h-6V4" />
                            <path d="M14 10l7-7" />
                            <path d="M3 21l6-7" />
                        </svg>
                    </button>
                </div>
                <Content />

                <ShareButtons
                    title={item.data.title}
                    url={Astro.url}
                    label="Share this lesson"
                />

                {/* <HorizontalAd /> */}

                <div class="lesson-navigation">
                    {prevLesson ? (
                        <a
                            href={`/education/${prevLesson.slug}`}
                            class="nav-card prev"
                        >
                            <span class="nav-label">Previous Lesson</span>
                            <span class="nav-title">
                                {prevLesson.data.title}
                            </span>
                        </a>
                    ) : (
                        <div class="nav-placeholder" />
                    )}
                    {nextLesson ? (
                        <a
                            href={`/education/${nextLesson.slug}`}
                            class="nav-card next"
                        >
                            <span class="nav-label">Next Lesson</span>
                            <span class="nav-title">
                                {nextLesson.data.title}
                            </span>
                        </a>
                    ) : (
                        <div class="nav-placeholder" />
                    )}
                </div>

                {currentCourseItems.length > 0 && (
                    <div class="all-chapters-section">
                        <ThinHorizontalAd />
                        <h2 class="section-title">All Chapters in this Book</h2>
                        <div class="chapters-grid">
                            {currentCourseItems.map((chapter, index) => {
                                const borderColors = [
                                    "border-blue-400 dark:border-blue-500",
                                    "border-purple-400 dark:border-purple-500",
                                    "border-orange-400 dark:border-orange-500",
                                    "border-green-400 dark:border-green-500",
                                    "border-pink-400 dark:border-pink-500",
                                    "border-teal-400 dark:border-teal-500",
                                ];
                                const borderColor =
                                    borderColors[index % borderColors.length];

                                return (
                                    <a
                                        href={`/education/${chapter.slug}`}
                                        class={`chapter-card ${borderColor}`}
                                    >
                                        <div class="card-content">
                                            <span class="chapter-label">
                                                Lesson {index + 1}
                                            </span>
                                            <h3 class="chapter-title">
                                                {chapter.data.title}
                                            </h3>
                                            <p class="chapter-description">
                                                {chapter.data.description}
                                            </p>
                                        </div>
                                        <div class="card-icon">
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="20"
                                                height="20"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                            >
                                                <path d="M5 12h14" />
                                                <path d="M12 5l7 7-7 7" />
                                            </svg>
                                        </div>
                                    </a>
                                );
                            })}
                        </div>
                    </div>
                )}
                <MultiplexAd />
            </article>
        </CourseLayout>
    ) : (
        <EducationSingleLayout
            title={item.data.title}
            description={item.data.description}
            pubDate={item.data.pubDate}
            image={item.data.image}
            institution={item.data.institution}
            courseType={item.data.courseType}
        >
            <Content />
        </EducationSingleLayout>
    )
}

<style>
    .prose :global(h1),
    .prose :global(h2),
    .prose :global(h3),
    .prose :global(h4),
    .prose :global(h5),
    .prose :global(h6) {
        /* font-family: var(--font-serif); */
        /* font-family: var(--font-carois) !important; */
        font-weight: 700;
        color: var(--color-heading);
    }

    .prose.max-w-75ch {
        max-width: 75ch;
        margin: 0 auto; /* Center the prose content itself */
    }

    /* Lesson Navigation Styles */
    .lesson-navigation {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--color-border);
    }

    .nav-card {
        display: flex;
        flex-direction: column;
        padding: 1.5rem;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        transition: all 0.3s ease;
        text-decoration: none;
        background: var(--color-surface);
        font-family: var(--font-sans); /* Inter */
    }

    .nav-card:hover {
        border-color: var(--color-primary);
        transform: translateY(-2px);
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.1);
        background: var(--color-surface); /* Override prose a:hover */
    }

    .nav-card.prev {
        text-align: left;
        align-items: flex-start;
    }

    .nav-card.next {
        text-align: right;
        align-items: flex-end;
    }

    .nav-label {
        font-family: "Montserrat", sans-serif;
        font-weight: 700;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-text-muted);
        margin-bottom: 0.5rem;
    }

    .nav-title {
        font-family: "Playfair Display", serif;
        font-family: var(--font-carrois);
        font-size: 1.5rem;
        font-weight: 700;
        /* font-style: italic; */
        color: var(--color-heading);
        line-height: 1.2;
    }

    .nav-placeholder {
        /* Empty div to maintain grid structure if one link is missing */
    }

    @media (max-width: 640px) {
        .lesson-navigation {
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        .nav-card.next {
            text-align: left;
            align-items: flex-start;
        }
    }

    /* Zen Mode Styles */
    .lesson-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
    }

    .zen-mode-btn {
        background: none;
        border: none;
        cursor: pointer;
        color: var(--color-text-muted);
        padding: 0.5rem;
        border-radius: 50%;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .zen-mode-btn:hover {
        background-color: var(--color-surface);
        color: var(--color-primary);
    }

    .hidden {
        display: none;
    }

    :global(body.zen-mode) :global(header),
    :global(body.zen-mode) :global(.mobile-controls) {
        display: none !important;
    }

    @media (max-width: 1024px) {
        :global(body.zen-mode) :global(.course-toc) {
            display: none !important;
        }
    }

    /* All Chapters Section */
    .all-chapters-section {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--color-border);
    }

    .section-title {
        font-family: "Montserrat", sans-serif !important;
        font-size: 1rem !important;
        color: var(--color-heading) !important;
        margin-bottom: 2rem !important;
        text-align: center;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .chapters-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.5rem;
    }

    .chapter-card {
        padding: 2rem;
        border-radius: 12px;
        text-decoration: none;
        transition: all 0.3s ease;
        border-width: 2px;
        border-style: solid;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        background: var(
            --color-surface
        ); /* Keep card background separate from hover mess */
    }

    .chapter-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.15);
        background: var(--color-surface) !important; /* Force keep background */
    }

    .card-content {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        flex: 1;
    }

    .chapter-label {
        font-family: "Montserrat", sans-serif;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-text-muted);
    }

    .chapter-card .chapter-title {
        font-family: var(--font-serif);
        font-size: 1.5rem !important;
        font-weight: 700;
        font-style: italic;
        margin: 0 !important;
        line-height: 1.2;
        color: var(--color-heading);
    }

    .chapter-description {
        font-family: var(--font-sans);
        font-size: 0.9rem;
        color: var(--color-text);
        opacity: 0.8;
        margin: 0 !important;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .card-icon {
        color: var(--color-text-muted);
        transition: transform 0.3s ease;
    }

    .chapter-card:hover .card-icon {
        transform: translateX(4px);
        color: var(--color-primary);
    }

    /* Pastel colors are handled via Tailwind utility classes in the HTML */
</style>

<script is:inline>
    // Blocking script to prevent flicker
    const savedZen = localStorage.getItem("zenMode") === "true";
    if (savedZen) {
        document.body.classList.add("zen-mode");
    }
</script>

<script>
    const zenToggle = document.getElementById("zen-mode-toggle");
    const enterIcon = document.querySelector(".zen-icon-enter");
    const exitIcon = document.querySelector(".zen-icon-exit");

    // Sync UI with current state (applied by blocking script)
    if (document.body.classList.contains("zen-mode")) {
        enterIcon?.classList.add("hidden");
        exitIcon?.classList.remove("hidden");
    }

    function toggleZenMode() {
        document.body.classList.toggle("zen-mode");
        enterIcon?.classList.toggle("hidden");
        exitIcon?.classList.toggle("hidden");

        // Save preference
        const isZen = document.body.classList.contains("zen-mode");
        localStorage.setItem("zenMode", isZen.toString());
    }

    zenToggle?.addEventListener("click", toggleZenMode);

    // Support View Transitions
    document.addEventListener("astro:after-swap", () => {
        const isZen = localStorage.getItem("zenMode") === "true";
        if (isZen) {
            document.body.classList.add("zen-mode");
        }
    });
</script>

<script define:vars={{ slug: item.data.parent || item.slug }}>
    // Track recently viewed course
    try {
        const STORAGE_KEY = "recentlyViewedCourses";
        const MAX_ITEMS = 4;

        let recent = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");

        // Remove current if exists (to move to top)
        recent = recent.filter((item) => item.slug !== slug);

        // Add to front
        recent.unshift({
            slug: slug,
            timestamp: Date.now(),
        });

        // Trim
        if (recent.length > MAX_ITEMS) {
            recent = recent.slice(0, MAX_ITEMS);
        }

        localStorage.setItem(STORAGE_KEY, JSON.stringify(recent));
    } catch (e) {
        console.error("Failed to update recently viewed courses", e);
    }
</script>
