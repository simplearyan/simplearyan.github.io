---
import { getCollection } from "astro:content";
import CourseLayout from "../../layouts/CourseLayout.astro";
import EducationSingleLayout from "../../layouts/EducationSingleLayout.astro";
import ShareButtons from "../../components/ShareButtons.astro";

export async function getStaticPaths() {
    const educationItems = await getCollection("education");
    return educationItems.map((item) => ({
        params: { slug: item.slug },
        props: item,
    }));
}

const item = Astro.props;
const { Content, headings } = await item.render();

const isCourseContent =
    item.data.type === "unit" ||
    item.data.type === "subject" ||
    item.data.type === "module";
const courseTag = item.data.tags ? item.data.tags[0] : "Data Science";

// Navigation Logic
const educationItems = await getCollection("education");
const currentCourseItems = educationItems
    .filter(
        (i) =>
            i.data.parent === item.data.parent && i.data.parent !== undefined,
    )
    .sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const currentIndex = currentCourseItems.findIndex((i) => i.slug === item.slug);
const prevLesson =
    currentIndex > 0 ? currentCourseItems[currentIndex - 1] : null;
const nextLesson =
    currentIndex < currentCourseItems.length - 1
        ? currentCourseItems[currentIndex + 1]
        : null;
---

{
    isCourseContent ? (
        <CourseLayout
            title={item.data.title}
            currentSlug={item.slug}
            courseTag={courseTag}
            courseTitle={courseTag}
            headings={headings}
        >
            <article class="prose">
                <div class="lesson-header">
                    <h1>{item.data.title}</h1>
                    <button
                        id="zen-mode-toggle"
                        class="zen-mode-btn"
                        aria-label="Toggle Zen Mode"
                        title="Toggle Zen Mode"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="zen-icon-enter"
                        >
                            <path d="M8 3H5a2 2 0 0 0-2 2v3" />
                            <path d="M16 3h3a2 2 0 0 1 2 2v3" />
                            <path d="M8 21H5a2 2 0 0 1-2-2v-3" />
                            <path d="M16 21h3a2 2 0 0 0 2-2v-3" />
                        </svg>
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="zen-icon-exit hidden"
                        >
                            <path d="M8 12H5a2 2 0 0 1-2-2V7" />
                            <path d="M16 12h3a2 2 0 0 0 2-2V7" />
                            <path d="M8 12h-3a2 2 0 0 0-2 2v3" />
                            <path d="M16 12h3a2 2 0 0 1 2 2v3" />
                        </svg>
                    </button>
                </div>
                <Content />
                <ShareButtons
                    title={item.data.title}
                    url={Astro.url}
                    label="Share this lesson"
                />

                <div class="lesson-navigation">
                    {prevLesson ? (
                        <a
                            href={`/education/${prevLesson.slug}`}
                            class="nav-card prev"
                        >
                            <span class="nav-label">Previous Lesson</span>
                            <span class="nav-title">
                                {prevLesson.data.title}
                            </span>
                        </a>
                    ) : (
                        <div class="nav-placeholder" />
                    )}
                    {nextLesson ? (
                        <a
                            href={`/education/${nextLesson.slug}`}
                            class="nav-card next"
                        >
                            <span class="nav-label">Next Lesson</span>
                            <span class="nav-title">
                                {nextLesson.data.title}
                            </span>
                        </a>
                    ) : (
                        <div class="nav-placeholder" />
                    )}
                </div>
            </article>
        </CourseLayout>
    ) : (
        <EducationSingleLayout
            title={item.data.title}
            description={item.data.description}
            pubDate={item.data.pubDate}
            image={item.data.image}
            institution={item.data.institution}
            courseType={item.data.courseType}
        >
            <Content />
        </EducationSingleLayout>
    )
}

<style>
    .prose :global(h1),
    .prose :global(h2),
    .prose :global(h3),
    .prose :global(h4),
    .prose :global(h5),
    .prose :global(h6) {
        font-family: var(--font-serif);
        font-weight: 700;
        color: var(--color-heading);
    }

    /* Lesson Navigation Styles */
    .lesson-navigation {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--color-border);
    }

    .nav-card {
        display: flex;
        flex-direction: column;
        padding: 1.5rem;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        transition: all 0.3s ease;
        text-decoration: none;
        background: var(--color-surface);
        font-family: var(--font-sans); /* Inter */
    }

    .nav-card:hover {
        border-color: var(--color-primary);
        background: var(--color-primary);
        transform: translateY(-2px);
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.1);
    }

    .nav-card:hover .nav-label {
        color: var(--color-bg);
        opacity: 0.9;
    }

    .nav-card:hover .nav-title {
        color: var(--color-bg);
    }

    .nav-card.prev {
        text-align: left;
        align-items: flex-start;
    }

    .nav-card.next {
        text-align: right;
        align-items: flex-end;
    }

    .nav-label {
        font-family: "Montserrat", sans-serif;
        font-weight: 700;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-text-muted);
        margin-bottom: 0.5rem;
    }

    .nav-title {
        font-family: "Playfair Display", serif;
        font-size: 1.5rem;
        font-weight: 700;
        font-style: italic;
        color: var(--color-heading);
        line-height: 1.2;
    }

    .nav-placeholder {
        /* Empty div to maintain grid structure if one link is missing */
    }

    @media (max-width: 640px) {
        .lesson-navigation {
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        .nav-card.next {
            text-align: left;
            align-items: flex-start;
        }
    }

    /* Zen Mode Styles */
    .lesson-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
    }

    .zen-mode-btn {
        background: none;
        border: none;
        cursor: pointer;
        color: var(--color-text-muted);
        padding: 0.5rem;
        border-radius: 50%;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .zen-mode-btn:hover {
        background-color: var(--color-surface);
        color: var(--color-primary);
    }

    .hidden {
        display: none;
    }

    :global(body.zen-mode) :global(header),
    :global(body.zen-mode) :global(.mobile-controls) {
        display: none !important;
    }

    @media (max-width: 1024px) {
        :global(body.zen-mode) :global(.course-toc) {
            display: none !important;
        }
    }
</style>

<script>
    const zenToggle = document.getElementById("zen-mode-toggle");
    const enterIcon = document.querySelector(".zen-icon-enter");
    const exitIcon = document.querySelector(".zen-icon-exit");

    function toggleZenMode() {
        document.body.classList.toggle("zen-mode");
        enterIcon?.classList.toggle("hidden");
        exitIcon?.classList.toggle("hidden");

        // Save preference
        const isZen = document.body.classList.contains("zen-mode");
        localStorage.setItem("zenMode", isZen.toString());
    }

    // Initialize from storage
    const savedZen = localStorage.getItem("zenMode") === "true";
    if (savedZen) {
        // Don't auto-enable on load to avoid confusion, but maybe we should?
        // For now, let's start fresh or maybe just respect it?
        // Let's respect it but ensure UI syncs
        document.body.classList.add("zen-mode");
        enterIcon?.classList.add("hidden");
        exitIcon?.classList.remove("hidden");
    }

    zenToggle?.addEventListener("click", toggleZenMode);
</script>

<script define:vars={{ slug: item.data.parent || item.slug }}>
    // Track recently viewed course
    try {
        const STORAGE_KEY = "recentlyViewedCourses";
        const MAX_ITEMS = 4;

        let recent = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");

        // Remove current if exists (to move to top)
        recent = recent.filter((item) => item.slug !== slug);

        // Add to front
        recent.unshift({
            slug: slug,
            timestamp: Date.now(),
        });

        // Trim
        if (recent.length > MAX_ITEMS) {
            recent = recent.slice(0, MAX_ITEMS);
        }

        localStorage.setItem(STORAGE_KEY, JSON.stringify(recent));
    } catch (e) {
        console.error("Failed to update recently viewed courses", e);
    }
</script>
