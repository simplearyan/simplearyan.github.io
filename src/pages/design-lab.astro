---
import Layout from "../layouts/Layout.astro";
import AutoSubjectGrid from "../components/AutoSubjectGrid.astro";
---

<Layout
    title="Design Lab | Subject Cards"
    description="Testing new subject card designs"
>
    <div class="container">
        <h1>Subject Card Design Lab</h1>
        <p class="subtitle">
            Comparing three new design concepts for course subjects.
        </p>

        <section>
            <h2>Option A: Holographic Glass</h2>
            <p class="desc">Modern, immersive, glassmorphism. (Cinematic)</p>
            <div class="demo-grid">
                <AutoSubjectGrid
                    courseSlug="data-science"
                    cardStyle="holographic"
                    defaultIcon="⚛️"
                />
            </div>
        </section>

        <section>
            <h2>Option B: Swiss Grid</h2>
            <p class="desc">Bold, structured, high-contrast. (Textbook)</p>
            <div class="demo-grid">
                <AutoSubjectGrid
                    courseSlug="data-science"
                    cardStyle="swiss"
                    defaultIcon="01"
                />
            </div>
        </section>

        <section>
            <h2>Option C: Organic Paper</h2>
            <p class="desc">Textured, warm, hand-drawn feel. (Scribble)</p>
            <div class="demo-grid">
                <AutoSubjectGrid
                    courseSlug="data-science"
                    cardStyle="organic"
                    defaultIcon="📝"
                />
            </div>
        </section>
    </div>
</Layout>

<style>
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 4rem 2rem;
    }

    h1 {
        font-family: "Playfair Display", serif;
        font-size: 3rem;
        text-align: center;
        margin-bottom: 0.5rem;
    }

    .subtitle {
        text-align: center;
        color: var(--color-text-muted);
        margin-bottom: 4rem;
        font-size: 1.2rem;
    }

    section {
        margin-bottom: 6rem;
        padding: 3rem;
        border-radius: 20px;
        background: var(--color-bg);
        border: 1px dashed var(--color-border);
    }

    h2 {
        font-size: 2rem;
        margin-bottom: 0.5rem;
        font-family: "Inter", sans-serif;
    }

    .desc {
        color: var(--color-text-muted);
        margin-bottom: 2rem;
    }
</style>
