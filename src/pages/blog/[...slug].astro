import CaptionedFigure from "@demo/CaptionedFigure.astro";
import CardDealer from "@widgets/simulation/CardDealer.astro";
import Chart from "@widgets/charts/Chart.astro";
import CinematicCard from "@cards/CinematicCard.astro";
import CinematicContainer from "@widgets/cinematic/CinematicContainer.astro";
import CinematicHighlight from "@widgets/cinematic/CinematicHighlight.astro";
import CinematicText from "@widgets/cinematic/CinematicText.astro";
import CircleEmphasis from "@widgets/cinematic/CircleEmphasis.astro";
import Coin from "@widgets/simulation/Coin.astro";
import ColoredHeading from "@demo/ColoredHeading.astro";
import ConceptCard from "@demo/ConceptCard.astro";
import ConfidenceIntervalPlot from "@widgets/simulation/ConfidenceIntervalPlot.astro";
import CustomTable from "@ui/CustomTable.astro";
import Determinant from "@widgets/math/Determinant.astro";
import DiagramArrow from "@widgets/annotation/DiagramArrow.astro";
import Dice from "@widgets/simulation/Dice.astro";
import DiceSimulation from "@widgets/simulation/DiceSimulation.astro";
import DistributionPlot from "@widgets/simulation/DistributionPlot.astro";
import Emoji from "@ui/Emoji.astro";
import Equation from "@widgets/math/Equation.astro";
import EquationGraph from "@widgets/math/EquationGraph.astro";
import Flowchart from "@widgets/charts/Flowchart.astro";
import GaltonBoard from "@widgets/simulation/GaltonBoard.astro";
import HandDrawnBox from "@ui/HandDrawnBox.astro";
import Heatmap from "@widgets/simulation/Heatmap.astro";
import InteractiveCoin from "@widgets/simulation/InteractiveCoin.astro";
import InteractiveDice from "@widgets/simulation/InteractiveDice.astro";
import List from "@ui/List.astro";
import MapEmbed from "@widgets/diagram/MapEmbed.astro";
import MarkerHighlight from "@widgets/cinematic/MarkerHighlight.astro";
import Markmap from "@widgets/diagram/Markmap.astro";
import Matrix from "@widgets/math/Matrix.astro";
import Mermaid from "@widgets/diagram/Mermaid.astro";
import MindMap from "@widgets/charts/MindMap.astro";
import MindmapDemo from "@widgets/diagram/MindmapDemo.astro";
import NetworkGraph from "@widgets/simulation/NetworkGraph.astro";
import PlayingCard from "@cards/PlayingCard.astro";
import PlayingCardHand from "@widgets/simulation/PlayingCardHand.astro";
import ScatterPlot from "@widgets/simulation/ScatterPlot.astro";
import ScribbleBox from "@widgets/annotation/ScribbleBox.astro";
import ScribbleCard from "@cards/ScribbleCard.astro";
import ScribbleCircle from "@widgets/annotation/ScribbleCircle.astro";
import ScribbleHighlight from "@widgets/annotation/ScribbleHighlight.astro";
import ScribbleText from "@widgets/annotation/ScribbleText.astro";
import StrokeUnderline from "@widgets/cinematic/StrokeUnderline.astro";
import StyledMath from "@widgets/math/StyledMath.astro";
import System from "@widgets/math/System.astro";
import TreeDiagram from "@widgets/simulation/TreeDiagram.astro";
import TypewriterCode from "@widgets/cinematic/TypewriterCode.astro";
import TypewriterSyntax from "@widgets/cinematic/TypewriterSyntax.astro";
import Urn from "@widgets/simulation/Urn.astro";
import VennDiagram from "@widgets/simulation/VennDiagram.astro";
import ViolinPlot from "@widgets/simulation/ViolinPlot.astro";
import VoxContainer from "@widgets/charts/VoxContainer.astro";
import ZTestPlot from "@widgets/simulation/ZTestPlot.astro";

// Ad components
import MultiplexAd from "@ads/MultiplexAd.astro";
import HorizontalAd from "@ads/HorizontalAd.astro";
import FixedHorizontalAd from "@ads/FixedHorizontalAd.astro";
import InFeedAd from "@ads/InFeedAd.astro";
import InArticleAd from "@ads/InArticleAd.astro";
import H2Ad from "@ads/H2Ad.astro";
import BannerAd from "@ads/BannerAd.astro";

import OptimizedImage from "@ui/OptimizedImage.astro";
import TypingText from "@widgets/cinematic/TypingText.astro";
import Board from "@widgets/simulation/Board.astro";
import ScribbleCheck from "@widgets/annotation/ScribbleCheck.astro";
import ScribbleLine from "@widgets/annotation/ScribbleLine.astro";
import BarChart from "@widgets/charts/BarChart.astro";
import LineChart from "@widgets/charts/LineChart.astro";
import PieChart from "@widgets/charts/PieChart.astro";
import VoxLineChart from "@widgets/charts/VoxLineChart.astro";
import VoxBarChart from "@widgets/charts/VoxBarChart.astro";
import VoxPieChart from "@widgets/charts/VoxPieChart.astro";
import Highlight from "@widgets/annotation/Highlight.astro";
import Circle from "@widgets/annotation/Circle.astro";
import Arrow from "@widgets/annotation/Arrow.astro";
import Underline from "@widgets/annotation/Underline.astro";
import Aside from "@widgets/annotation/Aside.astro";
import BlogCard from "@cards/BlogCard.astro";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

export async function getStaticPaths() {
	const allPosts = await getCollection("blog");

	// Post Paths
	const postPaths = allPosts.map((post) => ({
		params: { slug: post.slug },
		props: { type: "post", post },
	}));

	// Tag Paths
	const uniqueTags = [
		...new Set(allPosts.map((post) => post.data.tags).flat()),
	];
	const tagPaths = uniqueTags.map((tag) => {
		const filteredPosts = allPosts
			.filter((post) => post.data.tags.includes(tag))
			.sort(
				(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
			);

		return {
			params: { slug: tag }, // slug is the tag name
			props: { type: "tag", tag, posts: filteredPosts },
		};
	});

	return [...postPaths, ...tagPaths];
}

type Props =
	| { type: "post"; post: CollectionEntry<"blog"> }
	| { type: "tag"; tag: string; posts: CollectionEntry<"blog">[] };

const props = Astro.props as Props;
const { type } = props;

// Variables for Post View
let post: CollectionEntry<"blog"> | undefined;
let Content: AstroComponentFactory | undefined;
let relatedPostsToShow: CollectionEntry<"blog">[] = [];
let latestPosts: CollectionEntry<"blog">[] = [];
let url: URL | undefined;

// Color Palettes
const pastelColors = [
	"#e0f2fe", // Light Sky
	"#fce7f3", // Light Pink
	"#dcfce7", // Light Green
	"#fef3c7", // Light Amber
	"#ede9fe", // Light Violet
	"#ffe4e6", // Light Rose
];

const darkColors = [
	"#0c4a6e", // Dark Sky
	"#831843", // Dark Pink
	"#14532d", // Dark Green
	"#78350f", // Dark Amber
	"#4c1d95", // Dark Violet
	"#881337", // Dark Rose
];

// Variables for Tag View
let tag: string | undefined;
let tagPosts: CollectionEntry<"blog">[] | undefined;

if (type === "post") {
	post = props.post;
	const renderResult = await post.render();
	Content = renderResult.Content;
	url = new URL(Astro.url.pathname, Astro.site);

	// Get related posts
	const allPosts = await getCollection("blog");
	const currentTags = post!.data.tags || [];

	const relatedPosts = allPosts
		.filter((p) => p.slug !== post!.slug)
		.map((p) => {
			const commonTags =
				p.data.tags?.filter((t) => currentTags.includes(t)) || [];
			return {
				post: p,
				score: commonTags.length,
			};
		})
		.filter((item) => item.score > 0)
		.sort((a, b) => {
			if (b.score !== a.score) return b.score - a.score; // Higher score first
			return (
				b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf()
			); // Newer first
		})
		.map((item) => item.post);

	// Get up to 4 related posts
	relatedPostsToShow = relatedPosts.slice(0, 4);
	if (relatedPostsToShow.length < 4) {
		const morePosts = allPosts
			.filter(
				(p) => p.slug !== post!.slug && !relatedPostsToShow.includes(p),
			)
			.slice(0, 4 - relatedPostsToShow.length);
		relatedPostsToShow = [...relatedPostsToShow, ...morePosts];
	}

	// Get latest posts (excluding current and related)
	latestPosts = allPosts
		.filter((p) => p.slug !== post!.slug && !relatedPostsToShow.includes(p))
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
		.slice(0, 4);
} else {
	tag = props.tag;
	tagPosts = props.posts;
}

const components = {
	AnimatedCard,
	ArrowEmphasis,
	BookCard,
	BoxPlot,
	Callout,
	CaptionedFigure,
	CardDealer,
	Chart,
	CinematicCard,
	CinematicContainer,
	CinematicHighlight,
	CinematicText,
	CircleEmphasis,
	Coin,
	ColoredHeading,
	ConceptCard,
	ConfidenceIntervalPlot,
	CustomTable,
	Determinant,
	DiagramArrow,
	Dice,
	DiceSimulation,
	DistributionPlot,
	Emoji,
	Equation,
	EquationGraph,
	Flowchart,
	GaltonBoard,
	HandDrawnBox,
	Heatmap,
	InteractiveCoin,
	InteractiveDice,
	List,
	MapEmbed,
	MarkerHighlight,
	Markmap,
	Matrix,
	Mermaid,
	MindMap,
	MindmapDemo,
	NetworkGraph,
	PlayingCard,
	PlayingCardHand,
	ScatterPlot,
	ScribbleBox,
	ScribbleCard,
	ScribbleCircle,
	ScribbleHighlight,
	ScribbleText,
	StrokeUnderline,
	StyledMath,
	System,
	TreeDiagram,
	TypewriterCode,
	TypewriterSyntax,
	Urn,
	VennDiagram,
	ViolinPlot,
	VoxContainer,
	ZTestPlot,
	
	// Original components preserved
	ScribbleCheck,
	ScribbleLine,
	BarChart,
	LineChart,
	PieChart,
	VoxLineChart,
	VoxBarChart,
	VoxPieChart,
	Highlight,
	Circle,
	Arrow,
	Underline,
	Aside,
	
	// Other mappings
	h2: H2Ad,
	OptimizedImage,
	TypingText,
	Board,
};
---

{
	type === "post" && post && Content ? (
		<Layout
			title={post.data.title}
			description={post.data.description}
			image={post.data.image}
			type="article"
		>
			<article
				class={`blog-post animate-fade-in ${post.data.fancyHeadings ? "fancy-headings" : ""} ${post.data.hideToc ? "wide-layout" : ""}`}
			>
				<BannerAd />
				<header class="post-header">
					<div class="post-meta">
						<time datetime={post.data.pubDate.toISOString()}>
							{post.data.pubDate.toLocaleDateString("en-US", {
								year: "numeric",
								month: "long",
								day: "numeric",
							})}
						</time>
						<span class="separator">•</span>
						<span class="author">By {post.data.author}</span>
					</div>
					<h1>{post.data.title}</h1>
					<div class="tags">
						{post.data.tags.map((t) => (
							<a href={`/blog/${t}`} class="tag">
								#{t}
							</a>
						))}
					</div>
					{post.data.image && post.data.showImage && (
						<div class="hero-image-wrapper">
							<OptimizedImage
								src={post.data.image}
								alt={post.data.title}
								style="clean"
								animation="zoom-in"
								class="blog-hero-image"
							/>
						</div>
					)}
				</header>

				<div class="prose">
					<Content components={components} />
				</div>

				<ShareButtons title={post.data.title} url={url!} />

				<script
                    async
                    src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7993314093599705"
                    crossorigin="anonymous">
                </script>

                <script>
                    document.addEventListener("DOMContentLoaded", () => {
                        const ads = document.querySelectorAll('.in-article-ad-container');
                        
                        if (ads.length === 0) {
                             console.log("H2Ad: No suitable headings found for ad placement");
                             return;
                        }

                        console.log(`H2Ad: Found ${ads.length} ads to activate`);

                        ads.forEach((ad, index) => {
                             // Show the ad
                            (ad as HTMLElement).style.display = 'block';
                            
                            // Trigger AdSense with a staggered delay (e.g., 500ms apart)
                            // This prevents race conditions or rate limiting when pushing multiple ads
                            setTimeout(() => {
                                try {
                                    console.log(`H2Ad: Pushing ad #${index + 1} to adsbygoogle`);
                                    ((window as any).adsbygoogle = (window as any).adsbygoogle || []).push({});
                                } catch (e) {
                                    console.error(`H2Ad: AdSense push failed for ad #${index + 1}`, e);
                                }
                            }, 500 * index + 100);
                        });
                    });
                </script>

				{relatedPostsToShow.length > 0 && (
					<div class="related-post-container">
						<FixedHorizontalAd />
						<h3 class="related-heading">Read Next</h3>
						<div class="related-grid">
							{relatedPostsToShow.map((relatedPost, index) => {
								const colorIndex = index % pastelColors.length;
								let light = pastelColors[colorIndex];
								let dark = darkColors[colorIndex];

								if (relatedPost.data.cardColor) {
									light = relatedPost.data.cardColor;
									dark = "#1f2937";
								}

								return (
									<BlogCard
										title={relatedPost.data.title}
										description={
											relatedPost.data.description
										}
										date={relatedPost.data.pubDate}
										image={relatedPost.data.image}
										href={`/blog/${relatedPost.slug}`}
										tags={relatedPost.data.tags}
										lightColor={light}
										darkColor={dark}
									/>
								);
							})}
						</div>
					</div>
				)}

				{latestPosts.length > 0 && (
					<div class="related-post-container">
						<h3 class="related-heading">NEW POSTS</h3>
						<div class="related-grid">
							{latestPosts.map((latestPost, index) => {
								const colorIndex =
									(index + relatedPostsToShow.length) %
									pastelColors.length; // Offset index to avoid same colors as above if possible
								let light = pastelColors[colorIndex];
								let dark = darkColors[colorIndex];

								if (latestPost.data.cardColor) {
									light = latestPost.data.cardColor;
									dark = "#1f2937";
								}

								return (
									<BlogCard
										title={latestPost.data.title}
										description={
											latestPost.data.description
										}
										date={latestPost.data.pubDate}
										image={latestPost.data.image}
										href={`/blog/${latestPost.slug}`}
										tags={latestPost.data.tags}
										lightColor={light}
										darkColor={dark}
									/>
								);
							})}
						</div>
					</div>
				)}

			<MultiplexAd />
			</article>
		</Layout>
	) : type === "tag" && tag && tagPosts ? (
		<Layout
			title={`Blog Posts tagged with ${tag} | SimpleAryan`}
			description={`Browse all blog posts tagged with ${tag}.`}
			fullWidth={true}
		>
			<div class="hero">
				<div class="container">
					<h1 class="animate-fade-in">
						{tag.charAt(0).toUpperCase() + tag.slice(1)}
					</h1>
					<p class="subtitle animate-fade-in">
						Discover articles, guides, and insights related to{" "}
						<strong>{tag}</strong>.
					</p>
					<div class="back-link animate-fade-in">
						<a href="/blog">← View all articles</a>
					</div>
				</div>
			</div>

			<div class="wide-container content-grid">
				{tagPosts.map((p, index) => {
					// 1. Pastel Palette (Light Mode)
					const pastelColors = [
						"#e0f2fe", // Light Sky
						"#fce7f3", // Light Pink
						"#dcfce7", // Light Green
						"#fef3c7", // Light Amber
						"#ede9fe", // Light Violet
						"#ffe4e6", // Light Rose
					];

					// 2. Dark Palette (Dark Mode)
					const darkColors = [
						"#0c4a6e", // Dark Sky
						"#831843", // Dark Pink
						"#14532d", // Dark Green
						"#78350f", // Dark Amber
						"#4c1d95", // Dark Violet
						"#881337", // Dark Rose
					];

					const colorIndex = index % pastelColors.length;
					let light = pastelColors[colorIndex];
					let dark = darkColors[colorIndex];

					if (p.data.cardColor) {
						light = p.data.cardColor;
						dark = "#1f2937";
					}

					return (
						<>
							<BlogCard
								title={p.data.title}
								description={p.data.description}
								date={p.data.pubDate}
								image={p.data.image}
								href={`/blog/${p.slug}`}
								tags={p.data.tags}
								lightColor={light}
								darkColor={dark}
							/>
							{index === 2 && <InFeedAd />}
						</>
					);
				})}
			</div>
			<div class="wide-container">
				<MultiplexAd />
			</div>
		</Layout>
	) : null
}

<style>
	/* Shared Styles */
	.container {
		max-width: 800px;
		margin: 0 auto;
		padding: 0 var(--spacing-md);
	}

	.wide-container {
		width: 100%;
		max-width: 800px;
		margin: 0 auto;
		padding: 0 var(--spacing-md);
		transition: max-width 0.3s ease;
	}

	@media (min-width: 1250px) {
		.wide-container {
			max-width: 1200px;
		}
	}

	/* Post Styles */
	.blog-post {
		max-width: 800px;
		margin: 0 auto;
		padding: var(--spacing-lg) 0;
		transition: max-width 0.3s ease;
	}

	.blog-post.wide-layout {
		max-width: 1200px;
	}

	.post-header {
		text-align: center;
		margin-bottom: var(--spacing-xl);
		border-bottom: 1px solid var(--color-border);
		padding-bottom: var(--spacing-lg);
	}

	.post-meta {
		color: #888;
		font-size: 0.9rem;
		margin-bottom: var(--spacing-sm);
	}

	.separator {
		margin: 0 0.5rem;
	}

	h1 {
		font-size: 3rem;
		margin-bottom: var(--spacing-md);
		letter-spacing: -0.03em;
	}

	.tags {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
		margin-bottom: 2rem;
	}

	.tag {
		font-size: 0.8rem;
		background-color: var(--color-code-bg);
		padding: 0.25rem 0.75rem;
		border-radius: 99px;
		color: var(--color-text);
		font-family: var(--font-mono);
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.tag:hover {
		background-color: var(--color-primary);
		color: var(--color-bg);
		transform: translateY(-1px);
	}

	.hero-image-wrapper {
		margin-top: 2rem;
		width: 100%;
	}

	:global(.blog-hero-image) {
		width: 100%;
		max-height: 500px;
		object-fit: cover;
		border-radius: 12px;
		box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.15);
	}

	/* Fancy Headings Styles */
	.fancy-headings h1 {
		font-family: "Playfair Display", serif;
		font-style: italic;
		font-weight: 700;
	}

	.fancy-headings :global(h2) {
		font-family: "Playfair Display", serif;
		font-size: 2.25rem;
		margin-top: 3.5rem;
		margin-bottom: 1.5rem;
		color: var(--color-heading);
	}

	.fancy-headings :global(h3) {
		font-family: "Playfair Display", serif;
		font-size: 1.75rem;
		margin-top: 2.5rem;
		margin-bottom: 1rem;
		color: var(--color-heading);
	}

	/* Related Post Styles */
	.related-post-container {
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid var(--color-border);
	}

	.related-heading {
		font-family: "Inter", sans-serif !important;
		font-size: 1rem !important;
		text-transform: uppercase !important;
		letter-spacing: 0.1em !important;
		color: var(--color-text-muted) !important;
		margin-bottom: 2rem !important;
		text-align: center !important;
		margin-top: 2.5rem !important;
	}

	.related-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 2rem;
	}

	/* Tag Page Styles */
	.hero {
		padding: var(--spacing-xl) 0;
		text-align: center;
		background-color: var(--color-bg);
		border-bottom: 1px solid var(--color-border);
		margin: 0 auto var(--spacing-xl);
		max-width: 800px;
	}

	.hero h1 {
		font-size: 3.5rem;
		margin-bottom: var(--spacing-sm);
		font-family: var(--font-serif);
		text-transform: capitalize;
	}

	.subtitle {
		font-size: 1.2rem;
		color: var(--color-text-muted);
		max-width: 600px;
		margin: 0 auto var(--spacing-md);
	}

	.back-link a {
		color: var(--color-primary);
		text-decoration: none;
		font-weight: 500;
		transition: opacity 0.2s;
	}

	.back-link a:hover {
		opacity: 0.8;
		text-decoration: underline;
	}

	.content-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
		gap: var(--spacing-lg);
		padding-bottom: var(--spacing-xl);
	}

	@media (max-width: 768px) {
		.hero h1 {
			font-size: 2.5rem;
		}
	}
</style>
