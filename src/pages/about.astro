---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About Aryan">
  <section class="about-container animate-fade-in">
    <div class="profile-header">
      <div class="image-container">
        <img src="/aryan.jpg" alt="Aryan" class="profile-image" />
        <div class="image-backdrop"></div>
      </div>

      <div class="profile-info">
        <h1 class="name">Aryan</h1>
        <p class="tagline">Digital Craftsman & Civic Technologist</p>
        <div class="social-links">
          <a href="#" class="social-btn">Twitter</a>
          <a href="#" class="social-btn">GitHub</a>
          <a href="#" class="social-btn">LinkedIn</a>
        </div>
      </div>
    </div>

    <div class="bio prose">
      <p class="lead">
        Hello! I'm Aryan, a developer and designer passionate about the
        intersection of technology, society, and urban life.
      </p>

      <p>
        With <strong>CivicThesis</strong>, I aim to bridge the gap between
        complex data and public understanding. I believe that when we visualize
        the invisible forces shaping our cities—from transit patterns to
        economic flows—we empower citizens to participate more meaningfully in
        their communities.
      </p>

      <p>
        My work combines rigorous data analysis with intuitive design. I don't
        just write code; I craft experiences that tell stories. Whether it's
        building interactive dashboards for local governance or writing about
        the ethics of AI in public spaces, my goal is always clarity and impact.
      </p>

      <blockquote class="quote">
        "Design is not just what it looks like and feels like. Design is how it
        works."
      </blockquote>

      <h3 class="section-title">What I Do</h3>
      <ul class="skills-list">
        <li>
          <strong>Full-Stack Development:</strong> Building robust, scalable web
          applications.
        </li>
        <li>
          <strong>Data Visualization:</strong> Turning raw numbers into compelling
          visual narratives.
        </li>
        <li>
          <strong>UI/UX Design:</strong> Creating interfaces that are as beautiful
          as they are functional.
        </li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  .about-container {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--spacing-xl) 0;
  }

  .profile-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
  }

  .image-container {
    position: relative;
    width: 180px;
    height: 180px;
  }

  .profile-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    position: relative;
    z-index: 2;
    border: 4px solid var(--color-bg);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.2);
  }

  .image-backdrop {
    position: absolute;
    top: 10px;
    left: 10px;
    width: 100%;
    height: 100%;
    background: var(--color-primary);
    border-radius: 50%;
    z-index: 1;
    opacity: 0.2;
    transform: scale(1.05);
  }

  .name {
    font-family: "Playfair Display", serif;
    font-size: 4rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }

  .tagline {
    font-family: "Kalam", cursive;
    font-size: 1.5rem;
    color: #666;
    margin-bottom: var(--spacing-md);
    transform: rotate(-2deg);
    display: inline-block;
  }

  .social-links {
    display: flex;
    gap: var(--spacing-md);
    justify-content: center;
    margin-top: var(--spacing-md);
  }

  .social-btn {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s ease;
  }

  .social-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .bio {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--color-text);
  }

  .lead {
    font-size: 1.4rem;
    font-family: "Playfair Display", serif;
    font-weight: 400;
    color: var(--color-text);
    margin-bottom: var(--spacing-lg);
    border-left: 4px solid var(--color-primary);
    padding-left: 1rem;
  }

  .quote {
    font-family: "Playfair Display", serif;
    font-style: italic;
    font-size: 1.5rem;
    color: #555;
    border-left: none;
    text-align: center;
    margin: var(--spacing-xl) 0;
    padding: 0 var(--spacing-lg);
  }

  .section-title {
    font-family: "Playfair Display", serif;
    font-size: 2rem;
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-md);
    border-bottom: 2px solid var(--color-border);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .skills-list {
    list-style: none;
    padding: 0;
    margin-top: var(--spacing-md);
  }

  .skills-list li {
    margin-bottom: var(--spacing-md);
    padding-left: 2rem;
    position: relative;
  }

  .skills-list li::before {
    content: "→";
    font-family: "Kalam", cursive;
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-primary);
    font-weight: bold;
    font-size: 1.2rem;
  }

  strong {
    color: var(--color-text);
    font-weight: 700;
  }
</style>
