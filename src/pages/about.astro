---
import Layout from "@layouts/BaseLayout.astro";
---

<Layout title="About Aryan">
  <section class="about-container animate-fade-in">
    <div class="profile-header">
      <div class="image-container">
        <img src="/aryan.jpg" alt="Aryan" class="profile-image" />
        <div class="image-backdrop"></div>
      </div>

      <div class="profile-info">
        <h1 class="name">Aryan</h1>
        <p class="tagline">Student & Lifelong Learner</p>
        <div class="social-links">
          <!-- <a href="" class="social-btn">Twitter</a> -->
          <a
            href="https://github.com/simplearyan?tab=repositories"
            target="_blank"
            class="social-btn">GitHub</a
          >
          <!-- <a href="" class="social-btn">LinkedIn</a> -->
        </div>
      </div>
    </div>

    <div class="bio prose">
      <p class="lead">
        Hello! I'm Aryan. This website is my public notebook—a place where I
        document my journey through mathematics, data science, and computer
        science.
      </p>

      <p>
        I believe in <strong>learning in public</strong>. By sharing my notes,
        projects, and struggles, I hope to solidify my own understanding and
        perhaps help others on a similar path. Currently, I am pursuing a BS
        Degree in Data Science and Applications from IIT Madras.
      </p>

      <p>
        Here, you'll find my course notes, interactive explanations, and
        explorations into the world of numbers and code. My goal is to turn
        complex academic concepts into intuitive, visual, and engaging content.
      </p>

      <blockquote class="quote">
        "The best way to learn is to teach."
      </blockquote>

      <h3 class="section-title">Focus Areas</h3>
      <ul class="skills-list">
        <li>
          <strong>Data Science:</strong> Exploring statistics, machine learning, and
          data analysis.
        </li>
        <li>
          <strong>Mathematics:</strong> Diving deep into calculus, linear algebra,
          and logic.
        </li>
        <li>
          <strong>Web Development:</strong> Building tools to visualize and interact
          with knowledge.
        </li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  .about-container {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--spacing-xl) 0;
  }

  .profile-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
  }

  .image-container {
    position: relative;
    width: 180px;
    height: 180px;
  }

  .profile-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    position: relative;
    z-index: 2;
    border: 4px solid var(--color-bg);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.2);
  }

  .image-backdrop {
    position: absolute;
    top: 10px;
    left: 10px;
    width: 100%;
    height: 100%;
    background: var(--color-primary);
    border-radius: 50%;
    z-index: 1;
    opacity: 0.2;
    transform: scale(1.05);
  }

  .name {
    font-family: "Playfair Display", serif;
    font-size: 4rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }

  .tagline {
    font-family: "Kalam", cursive;
    font-size: 1.5rem;
    color: #666;
    margin-bottom: var(--spacing-md);
    transform: rotate(-2deg);
    display: inline-block;
  }

  .social-links {
    display: flex;
    gap: var(--spacing-md);
    justify-content: center;
    margin-top: var(--spacing-md);
  }

  .social-btn {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s ease;
  }

  .social-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .bio {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--color-text);
  }

  .lead {
    font-size: 1.4rem;
    font-family: "Playfair Display", serif;
    font-weight: 400;
    color: var(--color-text);
    margin-bottom: var(--spacing-lg);
    border-left: 4px solid var(--color-primary);
    padding-left: 1rem;
  }

  .quote {
    font-family: "Playfair Display", serif;
    font-style: italic;
    font-size: 1.5rem;
    color: #555;
    border-left: none;
    text-align: center;
    margin: var(--spacing-xl) 0;
    padding: 0 var(--spacing-lg);
  }

  .section-title {
    font-family: "Playfair Display", serif;
    font-size: 2rem;
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-md);
    border-bottom: 2px solid var(--color-border);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .skills-list {
    list-style: none;
    padding: 0;
    margin-top: var(--spacing-md);
  }

  .skills-list li {
    margin-bottom: var(--spacing-md);
    padding-left: 2rem;
    position: relative;
  }

  .skills-list li::before {
    content: "→";
    font-family: "Kalam", cursive;
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-primary);
    font-weight: bold;
    font-size: 1.2rem;
  }

  strong {
    color: var(--color-text);
    font-weight: 700;
  }
</style>
