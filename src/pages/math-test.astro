---
import Layout from "../layouts/EducationSingleLayout.astro";
import Matrix from "../components/math/Matrix.astro";
import Equation from "../components/math/Equation.astro";
import System from "../components/math/System.astro";
import Determinant from "../components/math/Determinant.astro";

const squareMatrix = [
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9],
];

const identityMatrix = [
    [1, 0, 0],
    [0, 1, 0],
    [0, 0, 1],
];

const diagonalMatrix = [
    [2, 0, 0],
    [0, 5, 0],
    [0, 0, 3],
];

const systemA = [
    [1, 2],
    [3, 4],
];
const systemX = ["x", "y"];
const systemB = [5, 11];

const detData = [
    [2, 3],
    [1, 4],
];
---

<Layout title="Math Components Test" description="Testing new math components">
    <main class="container">
        <h1>Math Components Gallery</h1>

        <section>
            <h2>Matrices</h2>

            <h3>Styles</h3>
            <div class="grid">
                <div>
                    <h4>Bracket (Default)</h4>
                    <Matrix data={squareMatrix} style="bracket" />
                </div>
                <div>
                    <h4>Glass</h4>
                    <Matrix data={squareMatrix} style="glass" />
                </div>
                <div>
                    <h4>Minimal</h4>
                    <Matrix data={squareMatrix} style="minimal" />
                </div>
                <div>
                    <h4>Neon</h4>
                    <Matrix data={squareMatrix} style="neon" />
                </div>
                <div>
                    <h4>Chalk</h4>
                    <Matrix data={squareMatrix} style="chalk" />
                </div>
            </div>

            <h3>Types</h3>
            <div class="grid">
                <div>
                    <h4>Identity</h4>
                    <Matrix data={identityMatrix} type="identity" />
                </div>
                <div>
                    <h4>Diagonal</h4>
                    <Matrix data={diagonalMatrix} type="diagonal" />
                </div>
            </div>

            <h3>Animations</h3>
            <div class="grid">
                <div>
                    <h4>Fade In</h4>
                    <Matrix
                        data={squareMatrix}
                        animate={true}
                        animationType="fade-in"
                    />
                </div>
                <div>
                    <h4>Reveal Diagonal</h4>
                    <Matrix
                        data={identityMatrix}
                        type="identity"
                        animate={true}
                        animationType="reveal-diagonal"
                    />
                </div>
            </div>
        </section>

        <section>
            <h2>Equations</h2>
            <Equation formula="E = mc^2" style="box" />
            <Equation
                formula="\int_0^\infty x^2 dx"
                style="glass"
                animate={true}
                animationType="slide-up"
            />
            <Equation
                formula="\sum_{i=1}^n i = \frac{n(n+1)}{2}"
                style="neon"
                animate={true}
                animationType="typewriter"
            />
        </section>

        <section>
            <h2>Systems (Ax = b)</h2>
            <System A={systemA} x={systemX} b={systemB} animate={true} />
        </section>

        <section>
            <h2>Determinants</h2>
            <Determinant data={detData} style="cross" animate={true} />
        </section>
    </main>
</Layout>

<style>
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
        color: var(--color-text);
    }

    section {
        margin-bottom: 4rem;
        padding: 2rem;
        border: 1px solid var(--color-border);
        border-radius: 1rem;
    }

    h2 {
        border-bottom: 2px solid var(--color-accent);
        padding-bottom: 0.5rem;
        margin-bottom: 2rem;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
    }
</style>
